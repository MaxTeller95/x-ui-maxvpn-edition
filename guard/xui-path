#!/usr/bin/env python3
"""xui-path - add or remove a backup path for tunnel-guard, from a share link.

    xui-path list [--json]
    xui-path add NAME "vless://...#whatever"      paste the link of a server abroad
    xui-path remove NAME
    xui-path rename NAME NEW                a new name everywhere (outbound, its mux and tunnel copies,
                                            probe port, rules, guard, split and tunnel settings; live)
    xui-path primary NAME [--force]         make a backup path the primary one (live, no restart):
                                            users' catch-all rule and the DNS cache's upstream move
                                            to it; a primary whose outbound is gone is dropped
    xui-path prune                          drop probe ports whose outbound is gone (no restart)
    options: --peer HOST   what to ping for this path (default: the link's address)
             --iface IF    the AWG tunnel this path rides (the guard watches its handshake)
             --addrs A,B   more addresses of the same server (other tunnels); after the add every
                           tunnel is scanned too, and the addresses that answer join the path
             --json       machine readable, for the Optimizer page

A path is three things that have to agree: an outbound in the panel's Xray template,
a local socks port so tunnel-guard can probe it on its own, and an entry in
/etc/tunnel-guard.json. This does all three at once, tests the config with
`xray -test` before it touches anything, restarts x-ui, then actually connects
through the new path and says whether it answered.

Supported links: vless (tcp/ws/xhttp/grpc/httpupgrade, none/tls/reality),
trojan, vmess, shadowsocks, and two QUIC (UDP) protocols for a fast backup on a lossy link:

  hysteria2:// (hy2://)  native in Xray: built the way the 3x-ui panel builds it from the same
                         link (salamander obfs and mport port hopping become finalmask masks)
  tuic://                Xray has no TUIC. The standard answer is sing-box as a sidecar: a local
                         SOCKS port in /etc/sing-box/config.json that sing-box sends on as TUIC,
                         and the path's outbound is that port. Needs sing-box installed; adding
                         or removing such a path restarts sing-box (its own tuns blink too).

Both ride UDP: where UDP abroad is throttled they fail, and the guard simply skips them.
The primary path cannot be removed: make another path primary first (its leftovers go with it
when its outbound was already deleted in the panel). A backup users are on right now is removed
after they are moved: back to the primary when it answers, else to the next backup that does.
"""
import base64, glob, json, os, re, shutil, subprocess, sys, time, urllib.parse
sys.path[:0] = [os.path.join(os.path.dirname(os.path.realpath(__file__)), d) for d in ("lib", "../lib")] + ["/usr/local/lib/xui-optimizer"]
import xuidb  # noqa: E402  the panel's database, SQLite or PostgreSQL, as x-ui itself uses it
import xuilive  # noqa: E402  template changes into the running Xray, no restart
import xuimix  # noqa: E402  a path mixed over several tunnels has copies and a balancer

DB, BIN = "/etc/x-ui/x-ui.db", "/usr/local/x-ui/bin"
CFG, GUARD_CONF = BIN + "/config.json", "/etc/tunnel-guard.json"
GUARD_STATE = "/var/lib/tunnel-guard/state.json"
KEY, PROBE_BASE = "xrayTemplateConfig", 10808
NAME_OK = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{1,23}$")
XRAY = (glob.glob(BIN + "/xray-linux-*") or [None])[0]


def die(msg, as_json=False):
    print(json.dumps({"ok": False, "msg": msg}, ensure_ascii=False) if as_json else msg)
    sys.exit(1)


def template(db=None):
    c = db or xuidb.connect()
    return json.loads(c.execute("select value from settings where key=?", (KEY,)).fetchone()[0])


def conf():
    try:
        with open(GUARD_CONF) as f:
            return json.load(f)
    except Exception:
        return {}


def unpad(s):
    return base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))


def parse_hysteria2(link):
    """hysteria2:// / hy2:// -> Xray's hysteria outbound, as 3x-ui's own link importer writes it."""
    u = urllib.parse.urlsplit(link)
    q = {k: v[0] for k, v in urllib.parse.parse_qs(u.query).items()}
    if not u.hostname:
        raise ValueError("آدرس در لینک hysteria2 پیدا نشد")
    tls = {"serverName": q.get("sni", ""), "alpn": (q.get("alpn") or "h3").split(",")}
    for key, field in (("fp", "fingerprint"), ("pinSHA256", "pinnedPeerCertSha256"), ("ech", "echConfigList")):
        if q.get(key):
            tls[field] = q[key]
    stream = {"network": "hysteria", "security": "tls",
              "hysteriaSettings": {"version": 2, "auth": urllib.parse.unquote(u.username or ""), "udpIdleTimeout": 60},
              "tlsSettings": tls}
    masks = []
    obfs = (q.get("obfs") or "").lower()
    password = q.get("obfs-password") or q.get("obfs_password") or q.get("obfsPassword")
    if obfs in ("salamander", "gecko") and password:
        masks.append({"type": "salamander", "settings": {"password": password}})
    if q.get("mport"):                                  # port hopping: xray 26.9.9's udphop mask
        masks.append({"type": "udphop", "settings": {"mode": "intervalremote", "interval": "5-10",
                                                     "remotePorts": q["mport"]}})
    if masks:
        stream["finalmask"] = {"udp": masks}
    return {"protocol": "hysteria", "settings": {"address": u.hostname, "port": u.port or 443, "version": 2},
            "streamSettings": stream}


def parse_tuic(link):
    """tuic://uuid:password@host:port?... -> what the sing-box sidecar needs."""
    u = urllib.parse.urlsplit(link)
    q = {k: v[0] for k, v in urllib.parse.parse_qs(u.query).items()}
    if not u.hostname or not u.username:
        raise ValueError("لینک tuic باید uuid:password@host:port باشد")
    return {"_tuic": {
        "server": u.hostname, "server_port": u.port or 443,
        "uuid": urllib.parse.unquote(u.username), "password": urllib.parse.unquote(u.password or ""),
        "congestion_control": q.get("congestion_control") or q.get("congestion") or "bbr",
        "udp_relay_mode": q.get("udp_relay_mode") or "native",
        "tls": {"enabled": True, "server_name": q.get("sni") or u.hostname,
                "alpn": (q.get("alpn") or "h3").split(","),
                "insecure": (q.get("allow_insecure") or q.get("insecure") or "0") in ("1", "true")}}}


SB_CONF = "/etc/sing-box/config.json"


def sidecar_tag(name):
    return "xp-" + name.lower()


def sidecar_write(c, as_json):
    """Check with sing-box itself, keep a copy, swap it in and restart sing-box."""
    sb = shutil.which("sing-box")
    tmp = SB_CONF + ".candidate"
    with open(tmp, "w") as f:
        json.dump(c, f, indent=2)
    r = subprocess.run([sb, "check", "-c", tmp], capture_output=True, text=True)
    if r.returncode:
        os.remove(tmp)
        die("sing-box این کانفیگ را رد کرد: " + ((r.stdout + r.stderr).strip().splitlines() or [""])[-1], as_json)
    if os.path.exists(SB_CONF):
        shutil.copy2(SB_CONF, SB_CONF + ".bak-" + time.strftime("%Y%m%d-%H%M%S"))
    os.replace(tmp, SB_CONF)
    subprocess.run(["systemctl", "restart", "sing-box"], check=False)
    time.sleep(2)


def sidecar_add(name, tuic, as_json):
    """A local SOCKS port that sing-box sends on as TUIC. Returns the port."""
    if not shutil.which("sing-box"):
        die("برای TUIC، sing-box لازم است (Xray پروتکل TUIC ندارد): bash <(curl -fsSL https://sing-box.app/deb-install.sh)",
            as_json)
    try:
        c = json.load(open(SB_CONF))
    except (OSError, ValueError):
        c = {"log": {"level": "warn"}, "inbounds": [], "outbounds": [{"type": "direct", "tag": "direct"}],
             "route": {"rules": []}}
    tag = sidecar_tag(name)
    import socket
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    c["inbounds"] = [i for i in c.get("inbounds", []) if i.get("tag") != tag + "-in"] + [
        {"type": "socks", "tag": tag + "-in", "listen": "127.0.0.1", "listen_port": port}]
    c["outbounds"] = [o for o in c.get("outbounds", []) if o.get("tag") != tag] + [dict(tuic, type="tuic", tag=tag)]
    route = c.setdefault("route", {})
    route["rules"] = [{"inbound": [tag + "-in"], "outbound": tag}] + [
        r for r in route.get("rules", []) if r.get("outbound") != tag]
    sidecar_write(c, as_json)
    return port


def sidecar_remove(name, as_json):
    tag = sidecar_tag(name)
    try:
        c = json.load(open(SB_CONF))
    except (OSError, ValueError):
        return
    if not any(o.get("tag") == tag for o in c.get("outbounds", [])):
        return
    c["inbounds"] = [i for i in c.get("inbounds", []) if i.get("tag") != tag + "-in"]
    c["outbounds"] = [o for o in c.get("outbounds", []) if o.get("tag") != tag]
    c.setdefault("route", {})["rules"] = [r for r in c["route"].get("rules", []) if r.get("outbound") != tag]
    sidecar_write(c, as_json)


def parse_link(link):
    """Turn a share link into an outbound, in the shape this panel writes them."""
    link = link.strip()
    scheme, _, rest = link.partition("://")
    scheme = scheme.lower()
    if scheme in ("hysteria2", "hy2"):
        return parse_hysteria2(link)
    if scheme == "tuic":
        return parse_tuic(link)
    if scheme == "vmess":                      # base64 of a json blob
        try:
            v = json.loads(unpad(rest.split("#")[0]))
        except Exception:
            raise ValueError("این لینک vmess خوانده نشد")
        q = {"type": v.get("net", "tcp"), "security": v.get("tls") or "none", "path": v.get("path", "/"),
             "host": v.get("host", ""), "sni": v.get("sni", ""), "serviceName": v.get("path", "")}
        return build("vmess", v.get("add"), int(v.get("port")), v.get("id"), q, extra={"aid": int(v.get("aid", 0) or 0)})
    if "@" not in rest:
        if scheme == "ss":                     # ss://base64(method:pass@host:port)
            rest = unpad(rest.split("#")[0].split("?")[0]).decode()
        else:
            raise ValueError("این لینک شناخته نشد")
    userinfo, _, hostpart = rest.partition("@")
    hostpart = hostpart.split("#")[0]
    host_port, _, query = hostpart.partition("?")
    host, _, port = host_port.rpartition(":")
    host = host.strip("[]")
    if not host or not port.isdigit():
        raise ValueError("آدرس یا پورت در لینک پیدا نشد")
    q = {k: v[0] for k, v in urllib.parse.parse_qs(query).items()}
    if scheme == "vless":
        return build("vless", host, int(port), urllib.parse.unquote(userinfo), q)
    if scheme == "trojan":
        return build("trojan", host, int(port), urllib.parse.unquote(userinfo), q)
    if scheme == "ss":
        method, _, password = unpad(userinfo).decode().partition(":") if ":" not in userinfo else userinfo.partition(":")[::2]
        return {"protocol": "shadowsocks",
                "settings": {"address": host, "port": int(port), "method": method, "password": password},
                "streamSettings": {"network": "tcp", "security": "none"}}
    raise ValueError("پروتکل %s پشتیبانی نمی‌شود" % scheme)


def build(proto, host, port, secret, q, extra=None):
    net, sec = q.get("type", "tcp"), (q.get("security") or "none")
    sec = "none" if sec in ("", "0", "none") else ("tls" if sec == "1" else sec)
    stream = {"network": net, "security": sec}
    if net == "ws":
        stream["wsSettings"] = {"path": urllib.parse.unquote(q.get("path", "/")),
                                "headers": {"Host": q.get("host") or q.get("sni") or host}}
    elif net == "xhttp":
        stream["xhttpSettings"] = {"path": urllib.parse.unquote(q.get("path", "/")), "mode": q.get("mode", "auto")}
        if q.get("host"):
            stream["xhttpSettings"]["host"] = q["host"]
    elif net == "grpc":
        stream["grpcSettings"] = {"serviceName": q.get("serviceName", "")}
    elif net == "httpupgrade":
        stream["httpupgradeSettings"] = {"path": urllib.parse.unquote(q.get("path", "/")),
                                         "host": q.get("host") or host}
    elif net == "tcp":
        stream["tcpSettings"] = {"header": {"type": q.get("headerType", "none")}}
    if sec == "tls":
        stream["tlsSettings"] = {"serverName": q.get("sni") or q.get("host") or host,
                                 "fingerprint": q.get("fp", "chrome"), "allowInsecure": q.get("allowInsecure") == "1"}
        if q.get("alpn"):
            stream["tlsSettings"]["alpn"] = urllib.parse.unquote(q["alpn"]).split(",")
    elif sec == "reality":
        if not q.get("pbk"):
            raise ValueError("لینک reality بدون کلید عمومی (pbk) است")
        stream["realitySettings"] = {"serverName": q.get("sni", ""), "publicKey": q["pbk"],
                                     "shortId": q.get("sid", ""), "fingerprint": q.get("fp", "chrome"),
                                     "spiderX": urllib.parse.unquote(q.get("spx", "/"))}
    if proto == "vless":
        settings = {"address": host, "port": port, "id": secret, "flow": q.get("flow", ""),
                    "encryption": urllib.parse.unquote(q.get("encryption") or "none")}   # VLESS Encryption
    elif proto == "vmess":
        settings = {"address": host, "port": port, "id": secret, "security": "auto",
                    "alterId": (extra or {}).get("aid", 0)}
    else:
        settings = {"address": host, "port": port, "password": secret}
    return {"protocol": proto, "settings": settings, "streamSettings": stream}


def probe_port(t):
    used = {i.get("port") for i in t.get("inbounds", [])} | {i.get("port") for i in json.load(open(CFG)).get("inbounds", [])}
    p = PROBE_BASE
    while p in used:
        p += 1
    return p


def test_config(t):
    cfg = json.load(open(CFG))
    for k in ("api", "outbounds", "routing", "dns", "burstObservatory", "observatory"):
        if k in t:
            cfg[k] = t[k]                               # a mix's balancers need the observatory
    cfg["inbounds"] = [i for i in cfg.get("inbounds", []) if not (i.get("tag") or "").startswith("guard-")] + \
                      [i for i in t.get("inbounds", []) if (i.get("tag") or "").startswith("guard-")]
    path = "/tmp/xui-path-candidate.json"
    with open(path, "w") as f:
        json.dump(cfg, f)
    os.chmod(path, 0o600)
    r = subprocess.run([XRAY, "run", "-test", "-c", path], cwd=BIN, capture_output=True, text=True)
    os.remove(path)
    out = r.stdout + r.stderr
    return "Configuration OK" in out, (out.strip().splitlines() or [""])[-1]


def apply(t, note, allow_restart=True):
    backup = "/root/xui-backup-" + time.strftime("%Y%m%d-%H%M%S")
    os.makedirs(backup, exist_ok=True)
    xuidb.backup_to(backup)
    shutil.copy2(CFG, backup)
    c = xuidb.connect()
    old = json.loads(c.execute("select value from settings where key=?", (KEY,)).fetchone()[0])
    c.execute("update settings set value=? where key=?", (json.dumps(t, indent=2), KEY))
    c.commit()
    c.close()
    # the new normal, saved before config.json changes: config-guard reacts to that write
    # and would otherwise put a removed path straight back
    subprocess.run(["config-guard", "--save"], capture_output=True)
    xuilive.apply(t, old, allow_restart)                # outbound, probe port, rule: live
    time.sleep(2)
    return backup


def try_path(port, tries=3):
    for _ in range(tries):
        r = subprocess.run(["curl", "-s", "-o", "/dev/null", "-m", "10", "--socks5-hostname",
                            "127.0.0.1:%d" % port, "-w", "%{http_code} %{time_total}",
                            "https://www.google.com/generate_204"], capture_output=True, text=True, timeout=14)
        p = r.stdout.split()
        if p and p[0] not in ("000", ""):
            return {"ok": True, "code": p[0], "secs": float(p[1])}
        time.sleep(2)
    return {"ok": False, "code": "000", "secs": None}


def write_conf(c):
    with open(GUARD_CONF + ".tmp", "w") as f:
        json.dump(c, f, indent=2)
    os.replace(GUARD_CONF + ".tmp", GUARD_CONF)


def listing():
    t, c = template(), conf()
    order = [c.get("primary")] + (c.get("backups") or [])
    outs = {o.get("tag"): o for o in t.get("outbounds", [])}
    probes = {i.get("tag"): i.get("port") for i in t.get("inbounds", []) if (i.get("tag") or "").startswith("guard-")}
    try:
        on = json.load(open(GUARD_STATE)).get("on")
    except Exception:
        on = None
    out = []
    for i, name in enumerate([n for n in order if n]):
        o, p = outs.get(name) or {}, (c.get("paths", {}).get(name) or {})
        s = o.get("settings") or {}
        out.append({"name": name, "role": "primary" if i == 0 else "backup %d" % i,
                    "protocol": o.get("protocol", "—"),
                    "address": "%s:%s" % (s.get("address", "?"), s.get("port", "?")) if s.get("address") else "—",
                    "security": (o.get("streamSettings") or {}).get("security", "—"),
                    "network": (o.get("streamSettings") or {}).get("network", "—"),
                    "iface": p.get("iface") or "", "peer": p.get("peer") or "",
                    "probe": probes.get("guard-" + name.lower()), "in_use": name == on,
                    "removable": i > 0, "gone": name not in outs,
                    "can_primary": i > 0 and name in outs})
    return out


def add(name, link, peer, as_json, iface="", addrs=()):
    if not NAME_OK.match(name):
        die("نام فقط حروف و عدد و - و _ (۲ تا ۲۴ کاراکتر)", as_json)
    t, c = template(), conf()
    if any(o.get("tag") == name for o in t.get("outbounds", [])):
        die("اوت‌باندی به اسم %s از قبل هست" % name, as_json)
    try:
        ob = parse_link(link)
    except ValueError as e:
        die(str(e), as_json)
    if "_tuic" in ob:                                   # through the sing-box sidecar
        tuic = ob.pop("_tuic")
        peer = peer or tuic["server"]
        sp = sidecar_add(name, tuic, as_json)
        ob = {"protocol": "socks", "settings": {"servers": [{"address": "127.0.0.1", "port": sp}]},
              "streamSettings": {"network": "tcp", "security": "none"}}
    ob["tag"] = name
    tag = "guard-" + name.lower()
    port = probe_port(t)
    t.setdefault("outbounds", []).append(ob)
    t.setdefault("inbounds", []).append({"tag": tag, "listen": "127.0.0.1", "port": port, "protocol": "socks",
                                         "settings": {"auth": "noauth", "udp": False}})
    rules = t.setdefault("routing", {}).setdefault("rules", [])
    last_guard = max([i for i, r in enumerate(rules) if (r.get("ruleTag") or "").startswith("guard-")] or [0])
    rules.insert(last_guard + 1, {"type": "field", "inboundTag": [tag], "outboundTag": name, "ruleTag": tag})

    ok, detail = test_config(t)
    if not ok:
        if ob.get("protocol") == "socks":               # a TUIC sidecar was made for it: take it back out
            sidecar_remove(name, as_json)
        die("Xray این کانفیگ را رد کرد: " + detail, as_json)
    backup = apply(t, "add " + name)
    addr, entry = ob["settings"].get("address", ""), {}
    if not peer and addr:
        r = subprocess.run(["ip", "route", "get", addr], capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.startswith("local "):
            # a local proxy (sing-box and the like): pinging it measures nothing. If the address
            # sits on a tun, the guard times the round trip through that tun instead.
            a = subprocess.run(["ip", "-o", "addr", "show", "to", addr], capture_output=True, text=True)
            dev = (a.stdout.split() + ["", ""])[1]
            if dev and dev != "lo":
                entry["tun"] = dev
            addr = ""
    entry["peer"] = peer or addr
    if iface:
        entry["iface"] = iface
    c.setdefault("paths", {})[name] = entry
    c.setdefault("backups", []).append(name)
    write_conf(c)
    res = try_path(port)
    msg = ("مسیر %s اضافه شد و جواب داد (HTTP %s در %.2f ثانیه)" % (name, res["code"], res["secs"]) if res["ok"]
           else "مسیر %s اضافه شد ولی از این سرور جواب نداد - تا وقتی سالم نشود نگهبان کاربران را به آن نمی‌برد" % name)
    out = {"ok": True, "msg": msg, "name": name, "probe": port, "reachable": res["ok"], "backup": backup}
    out.update(more_addresses(name, addrs))
    if out.get("tunnels_msg"):
        msg += "\n" + out["tunnels_msg"]
    print(json.dumps(out, ensure_ascii=False) if as_json else msg)


def more_addresses(name, addrs):
    """Right after a path is added: try its outbound on every tunnel's far address (and on the
    addresses typed with it), and list the ones that answer under the path, for xui-tunnel."""
    if not shutil.which("xui-tunnel"):
        return {}
    cmd = ["xui-tunnel", "scan", name] + ([",".join(addrs)] if addrs else []) + ["--save", "--json"]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    try:
        got = json.loads(r.stdout)
    except ValueError:
        return {}
    for a in addrs:                          # typed by hand: kept even if not up yet
        if a not in got.get("answered", []):
            subprocess.run(["xui-tunnel", "add", name, a, "--json"], capture_output=True, timeout=60)
    return {"tunnels": got.get("answered", []), "tunnels_msg": got.get("msg", "")}


def user_inbounds():
    """Tags of the panel's enabled inbounds: who a new catch-all rule is for."""
    db = xuidb.connect()
    try:
        rows = db.execute("select tag, enable from inbounds").fetchall()
    finally:
        db.close()
    return [r[0] for r in rows if r[0] and str(r[1]).lower() in ("1", "true", "t")]


def make_primary(name, as_json, force=False):
    """NAME becomes the primary path. Users' catch-all (main-OLD, or a new one for every inbound
    when the panel lost it) and the DNS cache's upstream are sent to NAME; when the old primary's
    outbound is gone, its leftovers (its -mux copy, probe port, split rules) go too."""
    t, c = template(), conf()
    old, backups = c.get("primary"), list(c.get("backups") or [])
    if name == old:
        die("%s از قبل مسیر اصلی است" % name, as_json)
    if name not in backups:
        die("مسیری به اسم %s در پشتیبان‌ها نیست" % name, as_json)
    outs = {o.get("tag") for o in t.get("outbounds", [])}
    if name not in outs:
        die("اوت‌باند %s در پنل نیست" % name, as_json)
    port = next((i.get("port") for i in t.get("inbounds", []) if i.get("tag") == "guard-" + name.lower()), None)
    if not force and port and not try_path(port)["ok"]:
        die("%s الان جواب نمی‌دهد؛ مسیر اصلی نشد (با --force بدون تست)" % name, as_json)
    old_gone = old not in outs
    route = xuimix.route(t, name)                       # its mix balancer when it is mixed
    rules, moved = t["routing"]["rules"], 0
    old_main = "main-" + (old or "").lower()
    for r in rules:
        is_main = r.get("ruleTag") == old_main or (not r.get("ruleTag") and xuimix.target(r) == old
                                                    and set(r) <= {"type", "inboundTag", "outboundTag", "balancerTag", "enabled"})
        is_dns = r.get("inboundTag") == ["dns-internal"] and xuimix.target(r) == old
        if is_main or is_dns:
            r.pop("outboundTag", None)
            r.pop("balancerTag", None)
            r.update(route)
            if is_main:
                r["ruleTag"] = "main-" + name.lower()
            moved += 1
    if not any(r.get("ruleTag") == "main-" + name.lower() for r in rules):
        tags = user_inbounds()
        if not tags:
            die("هیچ اینباند فعالی در پنل نیست؛ قانون اصلی ساخته نشد", as_json)
        rules.append(dict({"type": "field", "ruleTag": "main-" + name.lower(), "inboundTag": tags}, **route))
    if old_gone and old:                                 # what the deleted primary left behind
        dead = {old, old + "-mux"}
        t["outbounds"] = [o for o in t["outbounds"] if o.get("tag") not in dead]
        t["inbounds"] = [i for i in t.get("inbounds", []) if i.get("tag") not in {"guard-" + d.lower() for d in dead}]
        t["routing"]["rules"] = [r for r in t["routing"]["rules"] if xuimix.target(r) not in dead]
    ok, detail = test_config(t)
    if not ok:
        die("Xray کانفیگ جدید را رد کرد: " + detail, as_json)
    backup = apply(t, "primary " + name)
    # the guard's own failover rules pointed users at a backup; the catch-all does it now
    subprocess.run([XRAY, "api", "rmrules", "--server=" + xuilive.api_addr(json.load(open(CFG))),
                    "fo-main", "fo-dns", "fo-udp", "fo-heavy", "fo-telegram", "fo-light"],
                   capture_output=True)
    c["primary"] = name
    c["backups"] = [b for b in backups if b != name] + ([old] if old and not old_gone else [])
    if old_gone:
        for k in (old, old + "-mux"):
            c.get("paths", {}).pop(k, None)
            (c.get("tunnels") or {}).pop(k, None)
    write_conf(c)
    try:
        st = json.load(open(GUARD_STATE))
        st.update(on=name, failed_over=False)
        json.dump(st, open(GUARD_STATE, "w"))
    except (OSError, ValueError):
        pass
    hold = "/var/lib/tunnel-guard/hold"
    if os.path.exists(hold) and open(hold).read().strip() in (old, name):
        os.remove(hold)
    msg = "%s مسیر اصلی شد%s%s" % (name, "؛ %s که اوت‌باندش حذف شده بود پاک شد" % old if old_gone else
                                  "؛ %s پشتیبان شد" % old, "" if moved else " (قانون اصلی کاربران از نو ساخته شد)")
    print(json.dumps({"ok": True, "msg": msg, "backup": backup}, ensure_ascii=False) if as_json else msg)


def move_users_off(name, c, t, as_json):
    """Users are on backup NAME: send them to the primary when it answers, else to the next backup
    that does (the guard does it, through a one-run hold), and wait for it."""
    probes = {i.get("tag"): i.get("port") for i in t.get("inbounds", []) if (i.get("tag") or "").startswith("guard-")}
    outs = {o.get("tag") for o in t.get("outbounds", [])}
    prim = c.get("primary")
    for target in [prim] + [b for b in c.get("backups") or [] if b != name]:
        port = probes.get("guard-" + (target or "").lower())
        if target in outs and port and try_path(port, tries=2)["ok"]:
            break
    else:
        die("کاربرها روی %s هستند و هیچ مسیر دیگری جواب نمی‌دهد؛ حذف نشد" % name, as_json)
    hold = "/var/lib/tunnel-guard/hold"
    had = open(hold).read().strip() if os.path.exists(hold) else None
    with open(hold, "w") as f:
        f.write(target)
    subprocess.run(["systemctl", "start", "tunnel-guard.service"], capture_output=True, timeout=120)
    if had and had != name:
        with open(hold, "w") as f:
            f.write(had)
    else:
        os.remove(hold)
    try:
        on = json.load(open(GUARD_STATE)).get("on")
    except (OSError, ValueError):
        on = None
    if on == name:
        die("کاربرها از %s جابجا نشدند؛ حذف نشد" % name, as_json)
    return target


def rename_tag(tag, name, new):
    """NAME's tags under NEW: NAME, NAME-mux, mix~NAME~2b, mix-NAME, up~NAME, guard-name(-mux),
    main-name, split-name-*. Anything else stays."""
    if not tag:
        return tag
    lo, nlo = name.lower(), new.lower()
    for a, b in ((name, new), (name + "-mux", new + "-mux")):
        if tag == a:
            return b
        for pre in ("mix-", "up~"):
            if tag == pre + a:
                return pre + b
        if tag.startswith("mix~" + a + "~"):
            return "mix~" + b + tag[len("mix~" + a):]
    for a, b in ((lo, nlo), (lo + "-mux", nlo + "-mux")):
        for pre in ("guard-", "main-"):
            if tag == pre + a:
                return pre + b
    if tag.startswith("split-%s-" % lo):
        return "split-%s-" % nlo + tag[len("split-%s-" % lo):]
    return tag


def rename_in(t, name, new):
    """The template (or config.json) with NAME's tags renamed."""
    rt = lambda x: rename_tag(x, name, new)
    for o in t.get("outbounds", []):
        o["tag"] = rt(o.get("tag"))
        sock = (o.get("streamSettings") or {}).get("sockopt") or {}
        if sock.get("dialerProxy"):
            sock["dialerProxy"] = rt(sock["dialerProxy"])
    for i in t.get("inbounds", []):
        if (i.get("tag") or "").startswith("guard-"):
            i["tag"] = rt(i["tag"])
    routing = t.get("routing") or {}
    for r in routing.get("rules") or []:
        for k in ("outboundTag", "balancerTag", "ruleTag"):
            if r.get(k):
                r[k] = rt(r[k])
        if isinstance(r.get("inboundTag"), list):
            r["inboundTag"] = [rt(x) for x in r["inboundTag"]]
    for b in routing.get("balancers") or []:
        b["tag"], b["fallbackTag"] = rt(b.get("tag")), rt(b.get("fallbackTag"))
        b["selector"] = ["mix~%s~" % new + s[len("mix~%s~" % name):] if s.startswith("mix~%s~" % name) else
                         "mix~%s-mux~" % new if s == "mix~%s-mux~" % name else s for s in b.get("selector") or []]
        if b["fallbackTag"] is None:
            b.pop("fallbackTag")
    return t


def rename(name, new, as_json):
    t, c = template(), conf()
    order = [c.get("primary")] + (c.get("backups") or [])
    if name not in order:
        die("مسیری به اسم %s در نگهبان نیست" % name, as_json)
    if not NAME_OK.match(new) or new.endswith("-mux") or new.startswith(("mix", "up~")):
        die("نام فقط حروف و عدد و - و _ (۲ تا ۲۴ کاراکتر)، بدون -mux در آخر", as_json)
    taken = {o.get("tag") for o in t.get("outbounds", [])} | set(order) | set(c.get("paths") or {})
    if new in taken or new + "-mux" in taken or new.lower() in {x.lower() for x in taken if x}:
        die("اسم %s از قبل هست" % new, as_json)
    old_t = json.loads(json.dumps(t))
    t = rename_in(t, name, new)
    if t["outbounds"] and old_t["outbounds"] and t["outbounds"][0].get("tag") != old_t["outbounds"][0].get("tag"):
        die("%s اولین اوت‌باند (مسیر پیش‌فرض Xray) است؛ تغییر نامش ری‌استارت Xray می‌خواهد و انجام نشد" % name, as_json)
    ok, detail = test_config(t)
    if not ok:
        die("Xray کانفیگ با نام تازه را رد کرد: " + detail, as_json)
    # the guard's own failover rules live only in the running Xray: renamed there too, so the
    # one replacement of the rules keeps them pointed at the right outbound
    cfg = json.load(open(CFG))
    mine = {json.dumps(r, sort_keys=True) for r in xuilive.as_panel_writes(old_t["routing"]["rules"])}
    for r in cfg.get("routing", {}).get("rules", []):
        if json.dumps(r, sort_keys=True) not in mine:
            for k in ("outboundTag", "balancerTag"):
                if r.get(k):
                    r[k] = rename_tag(r[k], name, new)
    with open(CFG + ".tmp", "w") as f:
        json.dump(cfg, f, indent=2)
    os.chmod(CFG + ".tmp", 0o600)
    os.replace(CFG + ".tmp", CFG)
    try:
        backup = apply(t, "rename %s %s" % (name, new), allow_restart=False)
    except xuilive.Failed as e:
        die("در Xray در حال اجرا اعمال نشد (%s)" % e, as_json)
    rn = lambda x: rename_tag(x, name, new)
    rekey = lambda d: {rn(k): v for k, v in (d or {}).items()}
    c["primary"] = rn(c.get("primary"))
    c["backups"] = [rn(b) for b in c.get("backups") or []]
    c["paths"] = rekey(c.get("paths"))
    if "tunnels" in c:
        c["tunnels"] = rekey(c["tunnels"])
    write_conf(c)
    for path, fix in (("/etc/xui-split.json", lambda d: dict(d, groups=rekey(d.get("groups")))),
                      ("/var/lib/tunnel-guard/tunnels.json", rekey),
                      (GUARD_STATE, lambda d: dict(d, **{k: rekey(d[k]) for k in ("fails", "oks", "down", "last", "restart_told", "lights")
                                                         if isinstance(d.get(k), dict)},
                                                  on=rn(d.get("on")),
                                                  outages=[dict(o, path=rn(o.get("path"))) for o in d.get("outages") or []]))):
        try:
            d = json.load(open(path))
        except (OSError, ValueError):
            continue
        with open(path + ".tmp", "w") as f:
            json.dump(fix(d), f, indent=2, ensure_ascii=False)
        os.replace(path + ".tmp", path)
    hold = "/var/lib/tunnel-guard/hold"
    if os.path.exists(hold) and open(hold).read().strip() == name:
        with open(hold, "w") as f:
            f.write(new)
    db = xuidb.connect()                          # the panel's own traffic may leave through it
    if (db.execute("select value from settings where key='panelOutbound'").fetchone() or [""])[0] == name:
        db.execute("update settings set value=? where key='panelOutbound'", (new,))
        db.commit()
    db.close()
    subprocess.run(["config-guard", "--save"], capture_output=True)
    msg = "%s حالا %s است" % (name, new)
    print(json.dumps({"ok": True, "msg": msg, "backup": backup}, ensure_ascii=False) if as_json else msg)


def remove(name, as_json):
    t, c = template(), conf()
    if name == c.get("primary"):
        die("مسیر اصلی را نمی‌شود حذف کرد؛ اول یک مسیر دیگر را اصلی کنید (xui-path primary NAME)", as_json)
    if name not in (c.get("backups") or []):
        die("مسیری به اسم %s در نگهبان نیست" % name, as_json)
    try:
        on = json.load(open(GUARD_STATE)).get("on")
    except (OSError, ValueError):
        on = None
    moved = ""
    if on == name:
        if c.get("primary") not in {o.get("tag") for o in t.get("outbounds", [])}:
            # no primary to fail back to: users ride the panel's own rules, not a failover to NAME
            st = json.load(open(GUARD_STATE))
            st["on"] = c.get("primary")
            json.dump(st, open(GUARD_STATE, "w"))
        else:
            moved = move_users_off(name, c, t, as_json)
    tag = "guard-" + name.lower()
    xuimix.remove(t, name)                              # its per-tunnel copies and balancer go too
    t["outbounds"] = [o for o in t.get("outbounds", []) if o.get("tag") not in (name, name + "-mux")]
    t["inbounds"] = [i for i in t.get("inbounds", []) if i.get("tag") != tag]
    t["routing"]["rules"] = [r for r in t["routing"]["rules"]
                             if r.get("ruleTag") != tag and xuimix.target(r) != name]
    ok, detail = test_config(t)
    if not ok:
        die("Xray کانفیگ بدون این مسیر را رد کرد: " + detail, as_json)
    backup = apply(t, "remove " + name)
    sidecar_remove(name, as_json)                       # a TUIC path's part in sing-box, if it had one
    c["backups"] = [b for b in c.get("backups", []) if b != name]
    c.get("paths", {}).pop(name, None)
    c.get("paths", {}).pop(name + "-mux", None)
    (c.get("tunnels") or {}).pop(name, None)
    write_conf(c)
    msg = "مسیر %s حذف شد%s" % (name, " (کاربرها اول به %s رفتند)" % moved if moved else "")
    print(json.dumps({"ok": True, "msg": msg, "backup": backup}, ensure_ascii=False) if as_json else msg)


def prune(as_json):
    """Probe ports (and their rules and guard rows) left behind by an outbound that is gone.
    An orphan probe port is worse than useless: with no rule it falls through to the first
    outbound, so it "answers" and the page reports a path that does not exist."""
    db = xuidb.connect()
    t, c = template(db), conf()
    outs = {o.get("tag", "").lower() for o in t.get("outbounds", [])}
    dead = [i.get("tag") for i in t.get("inbounds", [])
            if (i.get("tag") or "").startswith("guard-") and i["tag"][6:] not in outs]
    ghost = [n for n in (c.get("paths") or {}) if n.lower() not in outs]
    if not dead and not ghost:
        msg = "چیز اضافه‌ای نیست"
        return print(json.dumps({"ok": True, "msg": msg, "removed": []}, ensure_ascii=False) if as_json else msg)
    t["inbounds"] = [i for i in t.get("inbounds", []) if i.get("tag") not in dead]
    t["routing"]["rules"] = [r for r in t["routing"].get("rules", []) if r.get("ruleTag") not in dead
                             and not set(r.get("inboundTag") or []) & set(dead)]
    ok, detail = test_config(t)
    if not ok:
        die("Xray کانفیگ پاک‌شده را رد کرد: " + detail, as_json)
    backup = "/root/xui-backup-" + time.strftime("%Y%m%d-%H%M%S")
    os.makedirs(backup, exist_ok=True)
    xuidb.backup_to(backup)
    shutil.copy2(CFG, backup)
    db.execute("update settings set value=? where key=?", (json.dumps(t, indent=2), KEY))
    db.commit()
    db.close()
    subprocess.run(["config-guard", "--save"], capture_output=True)   # before config.json is written
    live = json.load(open(CFG))                 # take them out of the running Xray too, no restart
    api = next(("%s:%s" % (i.get("listen") or "127.0.0.1", i["port"]) for i in live.get("inbounds", [])
                if i.get("tag") == (live.get("api") or {}).get("tag", "api")), "127.0.0.1:62789")
    for tag in dead:
        subprocess.run([XRAY, "api", "rmi", "--server=" + api, tag], capture_output=True)
    live["inbounds"] = [i for i in live.get("inbounds", []) if i.get("tag") not in dead]
    live["routing"]["rules"] = [r for r in live["routing"].get("rules", []) if r.get("ruleTag") not in dead]
    with open(CFG + ".tmp", "w") as f:
        json.dump(live, f, indent=2)
    os.replace(CFG + ".tmp", CFG)
    for n in ghost:
        c["paths"].pop(n, None)
    c["backups"] = [b for b in c.get("backups", []) if b.lower() in outs]
    write_conf(c)
    gone = dead + ["guard:" + n for n in ghost]
    msg = "پاک شد: " + "، ".join(gone)
    print(json.dumps({"ok": True, "msg": msg, "removed": gone, "backup": backup}, ensure_ascii=False)
          if as_json else msg)


def main():
    args = sys.argv[1:]
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    opt = {}
    for flag in ("--peer", "--iface", "--addrs"):
        if flag in args:
            i = args.index(flag)
            opt[flag] = args[i + 1] if len(args) > i + 1 else ""
            del args[i:i + 2]
    peer = opt.get("--peer", "")
    mode = args[0] if args else "list"
    if not XRAY:
        die("xray در %s پیدا نشد" % BIN, as_json)
    if mode == "list":
        print(json.dumps(listing(), ensure_ascii=False) if as_json else
              "\n".join("%-14s %-9s %-7s %-22s probe %s%s" % (p["name"], p["role"], p["protocol"], p["address"],
                                                              p["probe"], "  <- users here" if p["in_use"] else "")
                        for p in listing()))
    elif mode == "add" and len(args) >= 3:
        add(args[1], args[2], peer, as_json, opt.get("--iface", ""),
            [a.strip() for a in opt.get("--addrs", "").split(",") if a.strip()])
    elif mode == "remove" and len(args) >= 2:
        remove(args[1], as_json)
    elif mode == "rename" and len(args) >= 3:
        rename(args[1], args[2], as_json)
    elif mode == "primary" and len(args) >= 2:
        make_primary(args[1], as_json, "--force" in args)
    elif mode == "prune":
        prune(as_json)
    else:
        die(__doc__, as_json)


if __name__ == "__main__":
    if os.geteuid() != 0:
        sys.exit("run this as root")
    main()
