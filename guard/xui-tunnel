ADDR_OK = re.compile(r"^[A-Za-z0-9.:-]{2,64}(@[A-Za-z0-9_.-]{1,15})?$")   # ADDR or ADDR@tun


def run(*cmd, timeout=20):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def log(msg):
    syslog.openlog("xui-tunnel")
    syslog.syslog(msg)


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    os.replace(path + ".tmp", path)


def api_addr(cfg):
    tag = (cfg.get("api") or {}).get("tag", "api")
    for i in cfg.get("inbounds", []):
        if i.get("tag") == tag:
            return "%s:%s" % (i.get("listen") or "127.0.0.1", i.get("port"))
    return "127.0.0.1:62789"


# ---------------------------------------------------------------- where an outbound points

def _server(o):
    """The dict that holds address/port, whichever shape the outbound was written in."""
    s = o.get("settings") or {}
    if "address" in s:
        return s
    for k in ("vnext", "servers"):
        if s.get(k):
            return s[k][0]
    return {}


def iface_addrs():
    """{interface: its IPv4 address} and back, for sendThrough <-> ADDR@IFACE."""
    rc, raw = run("ip", "-j", "-4", "addr", "show", timeout=5)
    by_if = {}
    for l in (json.loads(raw) if rc == 0 else []):
        for a in l.get("addr_info", []):
            by_if.setdefault(l["ifname"], a["local"])
    return by_if


def split(entry):
    addr, _, via = (entry or "").partition("@")
    return addr, via


def addr_of(o, ifs=None):
    """The outbound's entry: its address, plus @IFACE when it is sent through a tun."""
    s = _server(o)
    addr, via = s.get("address"), o.get("sendThrough")
    if addr and via:
        name = next((i for i, a in (ifs or iface_addrs()).items() if a == via), via)
        addr = "%s@%s" % (addr, name)
    return addr, s.get("port")


def set_addr(o, entry, ifs=None):
    addr, via = split(entry)
    _server(o)["address"] = addr
    if via:
        local = (ifs or iface_addrs()).get(via)
        if not local:
            raise ValueError("تانل %s روی این هاب نیست" % via)
        o["sendThrough"] = local
    else:
        o.pop("sendThrough", None)


def family(name):
    """NAME and the outbounds that ride the same tunnel as it (NAME-mux)."""
    return (name, name + "-mux")


# ---------------------------------------------------------------- discovery

FAR_CACHE = "/var/lib/tunnel-guard/far.json"     # what traffic matching found, per tunnel and carrier process
LOOPBACK = ("127.", "::1", "::ffff:127.")


def proc_name(pid):
    try:
        return open("/proc/%s/comm" % pid).read().strip()
    except OSError:
        return ""


def tun_owner(iface):
    """The process that holds a tun device open (gost, sing-box, Backhaul, wireguard-go, ...)."""
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            for fd in os.listdir("/proc/%s/fdinfo" % pid):
                try:
                    if re.search(r"^iff:\s*%s\s*$" % re.escape(iface), open("/proc/%s/fdinfo/%s" % (pid, fd)).read(), re.M):
                        return pid
                except OSError:
                    continue
        except OSError:
            continue
    return ""


def udp_owner(port):
    """The process listening on local UDP PORT (the carrier an AWG endpoint 127.0.0.1:PORT feeds)."""
    rc, out = run("ss", "-Hulnp", "sport = :%s" % port, timeout=5)
    m = re.search(r"pid=(\d+)", out)
    return m.group(1) if m else ""


def remote_sockets(pid):
    """{(remote ip, local port, remote port): bytes moved} for PID's TCP connections off this box."""
    rc, out = run("ss", "-Htinp", "state", "established", timeout=8)
    got, lines = {}, out.splitlines()
    for i, line in enumerate(lines):
        if "pid=%s," % pid not in line:
            continue
        p = line.split()
        if len(p) < 4:
            continue
        lip, rip = p[2].rpartition(":")[0].strip("[]"), p[3].rpartition(":")[0].strip("[]")
        rip = rip[7:] if rip.startswith("::ffff:") else rip
        if rip.startswith(LOOPBACK) or rip == lip:
            continue
        info = lines[i + 1] if i + 1 < len(lines) else ""
        moved = sum(int(x) for x in re.findall(r"bytes_(?:acked|received):(\d+)", info))
        key = (rip, p[2].rpartition(":")[2], p[3].rpartition(":")[2])
        got[key] = got.get(key, 0) + moved
    return got


def far_by_traffic(pid, iface, peer):
    """Which of PID's connections carries IFACE: with one remote server it is that one; with
    several, a short burst of pings through the tunnel shows which connection moves."""
    socks = remote_sockets(pid)
    ips = {k[0] for k in socks}
    if len(ips) <= 1:
        return next(iter(ips), "")
    if not peer:
        return ""
    run("ping", "-n", "-q", "-c", "40", "-i", "0.02", "-s", "1200", "-W", "1", "-I", iface, peer, timeout=8)
    after = remote_sockets(pid)
    delta = {k: after.get(k, 0) - socks.get(k, 0) for k in after}
    best = max(delta, key=delta.get) if delta else None
    return best[0] if best and delta[best] >= 40 * 1000 else ""


def carrier_of(pid):
    """A carrier process's name and the protocol its connections use, e.g. 'gost · tcp'."""
    name = proc_name(pid)
    rc, out = run("ss", "-Hunp", timeout=5)
    udp = "pid=%s," % pid in out
    return "%s · %s" % (name or "?", "udp" if udp and not remote_sockets(pid) else "tcp")


def cached_far(iface, pid, find):
    """FIND() once per tunnel and carrier process (an hour at most): the ping burst is not repeated
    on every listing."""
    cache = load(FAR_CACHE, {})
    hit = cache.get(iface) or {}
    if hit.get("pid") == pid and hit.get("far") and time.time() - hit.get("at", 0) < 3600:
        return hit["far"]
    far = find()
    if far:
        cache[iface] = {"pid": pid, "far": far, "at": int(time.time())}
        save(FAR_CACHE, cache)
    return far


def far_of_endpoint(ep, iface=""):
    """An AWG endpoint of 127.0.0.1:P means a local carrier (wstunnel, udp2raw, ...) takes it
    abroad: the process listening on P, and the server it is connected to."""
    host, _, port = ep.rpartition(":")
    if host not in ("127.0.0.1", "localhost", "[::1]"):
        return host.strip("[]"), "udp"
    pid = udp_owner(port)
    if pid:
        far = cached_far(iface or ep, pid, lambda: far_by_traffic(pid, iface, ""))
        if far:
            return far, carrier_of(pid)
    for unit in glob.glob("/etc/systemd/system/*.service"):          # the carrier is down: read its unit
        try:
            text = open(unit).read()
        except OSError:
            continue
        if re.search(r"127\.0\.0\.1:%s\b" % port, text):
            m = re.search(r"wss?://\[?([^\]/:\s]+)", text)
            if m:
                return m.group(1), "tcp (%s)" % os.path.basename(unit)[:-8]
    return "", "udp"


def singbox_far():
    """{tun interface: server} from sing-box's config: tun inbound -> route rule -> outbound."""
    out = {}
    for path in ("/etc/sing-box/config.json",):
        c = load(path, {})
        tuns = {i.get("tag"): i.get("interface_name") for i in c.get("inbounds", []) if i.get("type") == "tun"}
        servers = {o.get("tag"): o.get("server") for o in c.get("outbounds", [])}
        for r in (c.get("route") or {}).get("rules", []):
            ins = r.get("inbound")
            for t in ([ins] if isinstance(ins, str) else ins or []):
                if t in tuns and r.get("outbound") in servers:
                    out[tuns[t]] = servers[r["outbound"]]
    return out


def resolve(host):
    try:
        return socket.gethostbyname(host) if host else ""
    except OSError:
        return ""


def server_names():
    """{far ip: hostname} for the servers xui-mtu reached over SSH."""
    st = load("/var/lib/xui-optimizer/mtu.json", {})
    names = {}
    for addr, h in (st.get("hosts") or {}).items():
        if h.get("ok") and h.get("host"):
            names[addr] = h["host"]
    for t in (st.get("tunnels") or {}).values():
        if t.get("far") and t.get("far_host"):
            names.setdefault(t["far"], t["far_host"])
    return names


def tunnels():
    """Every point-to-point tunnel on this hub, with the server at its far end and what carries
    it - worked out, not configured: GRE/IPIP/Geneve/VXLAN by their remote, WireGuard/AmneziaWG
    by their endpoint (a local carrier on 127.0.0.1 is followed to its server), a tun by the
    process that holds it open and that process's connection (matched by traffic when it has
    several), and a tunnel whose remote lies inside another tunnel by that tunnel's server."""
    rc, raw = run("ip", "-j", "-d", "addr", "show")
    links = json.loads(raw) if rc == 0 else []
    sb = singbox_far()
    out = []
    for l in links:
        kind = (l.get("linkinfo") or {}).get("info_kind") or ""
        name = l["ifname"]
        v4 = [a for a in l.get("addr_info", []) if a.get("family") == "inet"]
        if not v4 or (kind not in ROUTED and kind != "tun"):
            continue
        a = v4[0]
        net = ipaddress.ip_interface("%s/%s" % (a["local"], a["prefixlen"])).network
        if net.prefixlen < 30:              # a /16 with many peers serves users, it is not a link abroad
            continue
        hosts = [str(h) for h in (net.hosts() if net.prefixlen == 30 else net) if str(h) != a["local"]]
        peer = hosts[0] if len(hosts) == 1 else ""
        t = {"iface": name, "kind": kind, "local": a["local"], "peer": peer, "far": "", "carrier": "", "via": "",
             "mtu": l.get("mtu"), "up": "UP" in l.get("flags", []) or l.get("operstate") in ("UP", "UNKNOWN"),
             "routed": kind in ROUTED}
        info = l["linkinfo"].get("info_data") or {}
        if kind in ("gre", "ipip", "sit", "geneve", "vxlan"):
            t["far"], t["carrier"] = info.get("remote") or "", kind
        elif kind in ("wireguard", "amneziawg"):
            tool = "awg" if kind == "amneziawg" else "wg"
            rc, eps = run(tool, "show", name, "endpoints", timeout=5)
            ep = (eps.split() + ["", ""])[1] if rc == 0 else ""
            if ep and ep != "(none)":
                t["far"], t["carrier"] = far_of_endpoint(ep, name)
            rc, hs = run(tool, "show", name, "latest-handshakes", timeout=5)
            last = int((hs.split() + ["0", "0"])[1] or 0) if rc == 0 else 0
            t["handshake"] = int(time.time()) - last if last else None
        elif name in sb:                    # sing-box: the outbound is sent through the tun, no peer
            t["far"], t["carrier"], t["peer"] = sb[name], "sing-box", ""
        else:                               # gost, Backhaul, ...: a routed tun with a peer
            pid = tun_owner(name)
            t["routed"] = bool(peer)
            if pid:
                t["far"] = cached_far(name, pid, lambda: far_by_traffic(pid, name, peer))
                t["carrier"] = carrier_of(pid)
        out.append(t)
    # a remote that is itself inside a tunnel (Geneve over a gost tun, AWG over AWG): that
    # tunnel's server is the far end, and the carrier says what it rides
    by_net = [(ipaddress.ip_interface("%s/30" % x["local"]).network, x) for x in out if x["local"]]
    for t in out:
        f = t["far"]
        try:
            ip = ipaddress.ip_address(f) if f else None
        except ValueError:
            ip = None
        outer = next((x for n, x in by_net if ip and ip in n and x is not t), None)
        if outer:
            t["via"] = outer["iface"]
    for _ in range(3):                      # nested more than once: follow it outward
        for t in out:
            outer = next((x for x in out if x["iface"] == t["via"]), None)
            if outer and outer.get("far"):
                t["far"] = outer["far"] if outer["via"] == "" else outer["far"]
    names = server_names()
    for t in out:
        if t["via"]:
            outer = next(x for x in out if x["iface"] == t["via"])
            t["carrier"] = "%s داخل %s (%s)" % (t["kind"], outer["iface"], outer["carrier"] or outer["kind"])
        t["far_ip"] = resolve(t["far"])
        t["far_host"] = names.get(t["far_ip"]) or names.get(t["far"], "")
    return out


def paths_on(tuns, outbounds):
    """Which outbound rides which tunnel: its address is the tunnel's peer (or sits on a tun)."""
    by_peer = {t["peer"]: t for t in tuns if t["peer"]}
    by_local = {t["local"]: t for t in tuns}
    use = {}
    for o in outbounds:
        if o.get("protocol") not in PROXY:
            continue
        addr, via = split(addr_of(o)[0])
        t = next((x for x in tuns if x["iface"] == via), None) if via else by_peer.get(addr) or by_local.get(addr)
        if t:
            use.setdefault(t["iface"], []).append(o["tag"])
    return use


def discover():
    cfg = load(CFG, {})
    tuns = tunnels()
    use = paths_on(tuns, cfg.get("outbounds", []))
    for t in tuns:
        t["paths"] = [p for p in use.get(t["iface"], []) if not p.endswith("-mux")]
        if t["routed"] and t["peer"]:
            t["ping"] = ping(t["peer"])
    return tuns


def ping(host):
    rc, out = run("ping", "-c", "2", "-i", "0.3", "-W", "2", "-q", host, timeout=8)
    m = re.search(r"= [\d.]+/([\d.]+)/", out)
    return round(float(m.group(1)), 1) if rc == 0 and m else None


# ---------------------------------------------------------------- the paths and their tunnels

def conf():
    return load(GUARD_CONF, {})


def template(db=None):
    c = db or xuidb.connect()
    return json.loads(c.execute("select value from settings where key=?", (KEY,)).fetchone()[0])


def candidates(name, cfg, tuns):
    """Addresses NAME could use: the peer of every routed tunnel that lands on the same server."""
    out = {o["tag"]: o for o in cfg.get("outbounds", [])}.get(name)
    if not out:
        return []
    addr, via = split(addr_of(out)[0])
    here = next((t for t in tuns if t["iface"] == via), None) if via else \
        next((t for t in tuns if t["routed"] and addr == t["peer"]), None)
    if not here or not here["far_ip"]:     # a path that sits on a sing-box proxy has its own credentials
        return []
    base = addr if not via else addr
    out = [{"addr": t["peer"], "iface": t["iface"], "kind": t["kind"], "carrier": t["carrier"]}
           for t in tuns if t["routed"] and t["peer"] and t["far_ip"] == here["far_ip"]]
    out += [{"addr": "%s@%s" % (base, t["iface"]), "iface": t["iface"], "kind": "sing-box", "carrier": "sing-box"}
            for t in tuns if t["kind"] == "tun" and t["local"] and t["far_ip"] == here["far_ip"]]
    return out


def route_of(entry, cache={}):
    """(interface, kind) the kernel sends ADDR through - every kind of tunnel (GRE, Geneve, AWG,
    a routed tun), named the way `ip` names it; ("", "direct") when it leaves by the uplink."""
    addr, via = split(entry)
    if via:
        return via, "sing-box"
    if addr in cache:
        return cache[addr]
    rc, out = run("ip", "-j", "route", "get", addr, timeout=5)
    dev = ""
    try:
        r = (json.loads(out) or [{}])[0] if rc == 0 else {}
        dev = r.get("dev", "")
        if r.get("gateway"):                         # through a gateway: the server's own uplink
            dev = ""
    except (ValueError, IndexError):
        pass
    kind = "direct" if not dev else ""
    if dev:
        rc, out = run("ip", "-j", "-d", "link", "show", "dev", dev, timeout=5)
        try:
            kind = ((json.loads(out) or [{}])[0].get("linkinfo") or {}).get("info_kind", "") if rc == 0 else ""
        except (ValueError, IndexError):
            kind = ""
    cache[addr] = (dev, kind)
    return cache[addr]


def listing():
    c, cfg, st = conf(), load(CFG, {}), load(STATE, {})
    tuns = tunnels()
    iface_of = {t["peer"]: t for t in tuns if t["peer"]}
    iface_of.update({"@" + t["iface"]: dict(t, kind="sing-box", carrier="sing-box") for t in tuns if t["kind"] == "tun"})
    info = lambda a: known.get(a) or iface_of.get(a) or iface_of.get("@" + split(a)[1]) or {}
    outs = {o["tag"]: o for o in cfg.get("outbounds", [])}
    managed = c.get("tunnels") or {}
    order = [n for n in [c.get("primary")] + (c.get("backups") or []) if n]
    ifs = iface_addrs()
    rows = []
    for name in order:
        o = outs.get(name)
        if not o or o.get("protocol") not in PROXY:
            continue
        addr, port = addr_of(o, ifs)
        spec = managed.get(name) or {}
        cand = candidates(name, cfg, tuns)
        addrs = list(spec.get("addrs") or [])
        scan = (st.get(name) or {}).get("scan") or {}
        seen = {x["addr"] for x in cand}
        cand += [dict(x) for x in scan.get("found", []) if x.get("ok") and x["addr"] not in seen]
        tests = (st.get(name) or {}).get("tests") or {}
        for x in cand:
            if x["addr"] not in addrs and x["addr"] != addr:
                x["new"] = True
                x["test"] = tests.get(x["addr"])
        known = {x["addr"]: x for x in cand}
        mx = spec.get("mix") or {}
        tpl_mix = xuimix.describe(cfg, name)
        mix = {"on": bool(xuimix.spec_of(c, name)) and tpl_mix["on"], "how": mx.get("how", "smart"),
               "addrs": mx.get("addrs") or [], "weights": mx.get("weights") or [],
               "live": tpl_mix["on"], "copies": tpl_mix["copies"], "drift": xuimix.drift(cfg, name),
               "pinned": pinned(name, cfg) if tpl_mix["on"] else None}
        mix["pending"] = bool(xuimix.spec_of(c, name)) != tpl_mix["on"]     # asked for, not in the config
        mix["loss"] = (st.get(name) or {}).get("loss_pct") or {}
        mix["out"] = (st.get(name) or {}).get("mix_out") or []
        mix["rtt"] = (st.get(name) or {}).get("rtt") or {}
        ps = st.get(name) or {}
        rank = ranked(addrs, ps) if measured(addrs, ps) else []
        rows.append({
            "name": name, "current": addr, "port": port, "auto": bool(spec.get("auto")), "mix": mix,
            "managed": bool(addrs), "order": spec.get("order") or "auto", "rank": rank, "up_at": ps.get("up_at"),
            "addrs": [dict(score(ps, a), addr=a, iface=info(a).get("iface") or route_of(a)[0],
                           kind=info(a).get("kind") or route_of(a)[1], carrier=info(a).get("carrier", ""),
                           live=a == addr, test=tests.get(a), place=(rank.index(a) + 1) if a in rank else None)
                      for a in addrs],
            "offer": [x for x in cand if x.get("new")],
            "scanned": scan.get("at"),
            "last": (st.get(name) or {}).get("events", [])[-5:],
        })
    return rows


# ---------------------------------------------------------------- testing an address

def free_port():
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    p = s.getsockname()[1]
    s.close()
    return p


@contextlib.contextmanager
def throwaway(name, addr, cfg=None):
    """A throwaway Xray with NAME's outbound pointed at ADDR: yields its local socks port (None
    when there is no such outbound). Nothing here is a user's traffic, nothing is billed."""
    cfg = cfg or load(CFG, {})
    o = next((x for x in cfg.get("outbounds", []) if x.get("tag") == name), None)
    if not o:
        yield None
        return
    o = json.loads(json.dumps(o))
    set_addr(o, addr)
    o["tag"] = "t"
    sock = (o.get("streamSettings") or {}).get("sockopt") or {}
    sock.pop("dialerProxy", None)
    port = free_port()
    tmp = {"log": {"loglevel": "none"},
           "inbounds": [{"listen": "127.0.0.1", "port": port, "protocol": "socks", "settings": {"udp": False}}],
           "outbounds": [o]}
    fd, path = tempfile.mkstemp(suffix=".json", prefix="xui-tunnel-")
    with os.fdopen(fd, "w") as f:
        json.dump(tmp, f)
    p = subprocess.Popen([XRAY, "run", "-c", path], cwd=BIN, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        time.sleep(0.8)
        yield port
    finally:
        p.kill()
        p.wait()
        os.remove(path)


def test(name, addr, cfg=None):
    """Start a throwaway Xray with NAME's outbound pointed at ADDR and fetch a page through it."""
    res = {"ok": False, "ms": None}
    with throwaway(name, addr, cfg) as port:
        if not port:
            return dict(res, err="no outbound " + name, at=int(time.time()))
        for _ in range(2):
            rc, out = run("curl", "-s", "-o", "/dev/null", "-m", "8", "--socks5-hostname", "127.0.0.1:%d" % port,
                          "-w", "%{http_code} %{time_total}", TEST_URL, timeout=12)
            parts = out.split()
            if parts and parts[0] not in ("000", ""):
                res = {"ok": True, "ms": int(float(parts[1]) * 1000)}
                break
            time.sleep(1)
    res["at"] = int(time.time())
    return res


# ---------------------------------------------------------------- upload speed and ranking

def blob():
    path = "/var/lib/tunnel-guard/upload.bin"
    if not os.path.exists(path) or os.path.getsize(path) != UP_BYTES:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "wb") as f:
            f.write(os.urandom(UP_BYTES))            # random: nothing on the way can compress it
    return path


def upload(name, addr, cfg=None):
    """Upload speed (Mbit/s) through NAME on ADDR, or None. TLS setup is left out of the time."""
    with throwaway(name, addr, cfg) as port:
        if not port:
            return None
        rc, out = run("curl", "-s", "-o", "/dev/null", "-m", "15", "--socks5-hostname", "127.0.0.1:%d" % port,
                      "-H", "Content-Type: application/octet-stream", "--data-binary", "@" + blob(),
                      "-w", "%{http_code} %{size_upload} %{time_total} %{time_pretransfer}", UP_URL, timeout=22)
    p = out.split()
    try:
        size, total, pre = int(float(p[1])), float(p[2]), float(p[3])
    except (IndexError, ValueError):
        return None
    if size < (1 << 20) or total - pre <= 0:
        return None
    return round(size * 8 / (total - pre) / 1e6, 1)


def remember(s, addr, ok):
    h = s.setdefault("okhist", {}).setdefault(addr, [])
    h.append(1 if ok else 0)
    del h[:-OK_KEEP]


def measure_uploads(name, addrs, s, cfg=None, force=False):
    """Each tunnel in turn (one at a time, so they do not share the hub's uplink). A tunnel whose
    pings all went unanswered last round is not waited on: it counts as failed."""
    now = int(time.time())
    if not force and now - s.get("up_at", 0) < UP_EVERY:
        return False
    s["up_at"] = now
    cfg = cfg or load(CFG, {})
    for a in addrs:
        last = ((s.get("loss") or {}).get(a) or [[1, 1]])[-1]
        mbps = upload(name, a, cfg) if force or last[1] > 0 else None
        remember(s, a, mbps is not None)
        h = s.setdefault("up", {}).setdefault(a, [])
        h.append([now, mbps])
        del h[:-UP_KEEP]
    for a in list(s.get("up") or {}):
        if a not in addrs:
            s["up"].pop(a)
    return True


def score(s, a, load=0.0):
    """{"up", "loss", "stab", "score"} for tunnel a of a path (state s). `load`: what users upload
    through it right now (Mbit/s), which its own measurement had to share the tunnel with."""
    ups = [x[1] for x in ((s.get("up") or {}).get(a) or [])[-3:] if x[1] is not None]
    up = round(statistics.median(ups) + load, 1) if ups else None
    loss = (s.get("loss_pct") or {}).get(a) or 0.0
    hist = (s.get("okhist") or {}).get(a) or []
    stab = sum(hist) / len(hist) if hist else 0.5
    sc = (up if up is not None else 0.0) * max(0.0, 1 - loss / LOSS_ZERO) * stab ** 2
    return {"up": up, "loss": loss, "stab": round(stab, 2), "score": round(sc, 2)}


def ranked(addrs, s):
    """addrs best first; ties (nothing measured yet) keep the list order."""
    sc = {a: score(s, a)["score"] for a in addrs}
    return sorted(addrs, key=lambda a: (-sc[a], addrs.index(a)))


def measured(addrs, s):
    """Enough to rank on: an upload result for at least two of the tunnels."""
    return sum(1 for a in addrs if any(x[1] is not None for x in ((s.get("up") or {}).get(a) or []))) >= 2


def rank_move(name, cur, pref, st, cfg, now):
    """Order on auto: go to the best-ranked tunnel when it stays clearly better. The current
    tunnel's measurement shared it with the users, so their upload is added back to it."""
    s = st[name]
    best = pref[0]
    if best == cur:
        s["rank_oks"] = 0
        return False
    load = (st.get("_users") or {}).get("total_mbps") or 0.0
    b = score(s, best)
    c = score(s, cur, load)["score"] if cur in pref else 0.0
    if not (b["score"] > 0 and b["score"] >= RANK_BETTER * c + 0.01):
        s["rank_oks"] = 0
        return False
    s["rank_oks"] = s.get("rank_oks", 0) + 1
    if s["rank_oks"] < RANK_ROUNDS or now - s.get("last_switch", 0) < RANK_GAP:
        return False
    r = test(name, best, cfg)
    remember(s, best, r["ok"])
    s["rank_oks"] = 0
    if not r["ok"]:
        return False
    save(STATE, st)
    use(name, best, "ranked better: up %s Mbit/s, loss %s%%" % (b["up"], b["loss"]))
    telegram("📈 %s: تانل %s بهتر است (آپلود %s Mbit/s، پکت لاست %s٪، پایداری %d٪)؛ مسیر بدون ری‌استارت روی آن رفت."
             % (name, best, b["up"], b["loss"], b["stab"] * 100))
    return True


# ---------------------------------------------------------------- heavy uploaders

def user_uplinks(cfg):
    """{email: bytes uploaded since Xray started}. Read only: no -reset, the panel bills on these."""
    rc, out = run(XRAY, "api", "statsquery", "--server=" + api_addr(cfg), "-pattern", "user>>>", timeout=15)
    got = {}
    try:
        for x in json.loads(out).get("stat") or []:
            p = x.get("name", "").split(">>>")
            if len(p) == 4 and p[3] == "uplink":
                got[p[1]] = int(x.get("value") or 0)
    except ValueError:
        return None
    return got


def steer_targets(c, st):
    """{path: tunnel address} a heavy uploader of that path is moved to: its best tunnel other than
    the one in use, answering at its last test. Single-tunnel paths with two or more tunnels only;
    not the primary while the guard has failed it over."""
    guard = load("/var/lib/tunnel-guard/state.json", {})
    cfg = load(CFG, {})
    outs = {o.get("tag"): o for o in cfg.get("outbounds", [])}
    got = {}
    for name, spec in (c.get("tunnels") or {}).items():
        addrs = spec.get("addrs") or []
        if len(addrs) < 2 or xuimix.spec_of(c, name) or name not in outs:
            continue
        if name == c.get("primary") and guard.get("failed_over"):
            continue
        s = st.get(name) or {}
        cur = addr_of(outs[name])[0]
        smart = measured(addrs, s)
        alive = lambda a: ((s.get("okhist") or {}).get(a) or [0])[-1] == 1 or ((s.get("tests") or {}).get(a) or {}).get("ok")
        pick = [a for a in (ranked(addrs, s) if smart else addrs)
                if a != cur and alive(a) and (not smart or score(s, a)["score"] > 0)]
        if pick:
            got[name] = pick[0]
    return got


def steer_template(t, moves):
    """The template with heavy uploaders' rules: for each path NAME in moves {NAME: (addr, users)},
    an outbound up~NAME (NAME aimed at addr) and, ahead of every rule that sends to NAME or NAME-mux,
    the same rule for those users only, sent to up~NAME. Earlier ones are taken out first."""
    t["outbounds"] = [o for o in t.get("outbounds", []) if not (o.get("tag") or "").startswith(STEER)]
    rules = [r for r in (t.get("routing") or {}).get("rules") or [] if not (r.get("outboundTag") or "").startswith(STEER)]
    outs = {o.get("tag"): o for o in t["outbounds"]}
    for name, (addr, users) in sorted(moves.items()):
        if name not in outs or not users:
            continue
        o = json.loads(json.dumps(outs[name]))
        o["tag"] = STEER + name
        set_addr(o, addr)
        t["outbounds"].append(o)
        out = []
        for r in rules:
            if r.get("outboundTag") in (name, name + "-mux") and "user" not in r and r.get("enabled") is not False:
                out.append(dict({k: v for k, v in r.items() if k not in ("ruleTag", "outboundTag", "comment")},
                                user=sorted(users), outboundTag=STEER + name))
            out.append(r)
        rules = out
    t.setdefault("routing", {})["rules"] = rules
    return t


def steer(c, now):
    """Who uploads heavily right now, and moving them (see the top)."""
    cfg = load(CFG, {})
    st = load(STATE, {})
    up = user_uplinks(cfg)
    if up is None:
        return
    u = st.setdefault("_users", {})
    prev, dt, pid = u.get("up") or {}, now - u.get("t", 0), xray_pid()
    u.update(t=now, up=up)
    if not prev or not 20 <= dt <= 600 or u.get("pid") != pid:      # a restart zeroes the counters
        u["pid"] = pid
        save(STATE, st)
        return
    rate = {e: (v - prev[e]) * 8 / dt / 1e6 for e, v in up.items() if e in prev and v >= prev[e]}
    u["total_mbps"] = round(sum(rate.values()), 1)
    limit = float(c.get("heavy_up_mbps") or HEAVY_MBPS)
    heavy = u.setdefault("heavy", {})
    for e in list(heavy):
        if rate.get(e, 0) < limit:
            heavy.pop(e)
    for e, r in rate.items():
        if r >= limit:
            heavy[e] = heavy.get(e, 0) + 1
    u["top"] = sorted(([e, round(r, 1)] for e, r in rate.items() if r >= 0.5), key=lambda x: -x[1])[:8]
    moved = st.setdefault("_steer", {})
    for e, m in list(moved.items()):
        if rate.get(e, 0) >= limit / 2:
            m["seen"], m["mbps"] = now, round(rate.get(e, 0), 1)
        elif now - m.get("seen", 0) >= CALM:
            moved.pop(e)
    for e in sorted(heavy, key=lambda e: -rate[e]):
        if heavy[e] >= HEAVY_ROUNDS and e not in moved and len(moved) < STEER_MAX:
            moved[e] = {"since": now, "seen": now, "mbps": round(rate[e], 1)}
    if c.get("steer") is False:
        moved.clear()
    targets = steer_targets(c, st) if moved else {}
    want = {n: (a, sorted(moved)) for n, a in targets.items()}
    before = {n: (a, sorted(us)) for n, (a, us) in (u.get("applied") or {}).items()}
    tpl_has = any((o.get("tag") or "").startswith(STEER) for o in cfg.get("outbounds", []))
    if want == before and bool(want) == tpl_has:
        save(STATE, st)
        return
    old = template()
    new = steer_template(json.loads(json.dumps(old)), want)
    if new != old:
        write_template(new)
        try:
            xuilive.apply(new, old, allow_restart=False)
        except xuilive.Failed as e:                      # never restart Xray for this
            write_template(old)
            log("heavy upload: not applied live (%s); left as it was" % e)
            save(STATE, st)
            return
        run("config-guard", "--save", timeout=30)
    u["applied"] = {n: [a, us] for n, (a, us) in want.items()}
    st.setdefault("_steer_log", []).append({"t": now, "to": {n: a for n, (a, _) in want.items()}, "users": sorted(moved)})
    st["_steer_log"] = st["_steer_log"][-20:]
    save(STATE, st)
    log("heavy upload: %s" % ((", ".join("%s -> %s" % (n, a) for n, (a, _) in want.items()) + " for " +
                                ", ".join(sorted(moved))) if want else "nobody moved"))


def track_loss(addrs, s):
    """Loss over the last minutes for every tunnel of a single-tunnel path (a mix has its own)."""
    with ThreadPoolExecutor(max_workers=max(1, len(addrs))) as ex:
        got = dict(zip(addrs, ex.map(ping_loss, addrs)))
    hist = s.setdefault("loss", {})
    for a in list(hist):
        if a not in addrs:
            hist.pop(a)
    for a, r in got.items():
        if r:
            hist.setdefault(a, []).append([r[0], r[1]])
            hist[a] = hist[a][-LOSS_WINDOW:]
            s.setdefault("rtt", {})[a] = r[2]
    s["loss_pct"] = {a: loss_pct(hist.get(a) or []) for a in addrs}
    return got


def scan(name, save_found=False, extra=()):
    """Start NAME's outbound on every tunnel's far address (and any extra address) at once;
    the ones that fetch a page carry the same service. With save_found, they join NAME's list."""
    cfg = load(CFG, {})
    o = next((x for x in cfg.get("outbounds", []) if x.get("tag") == name), None)
    if not o or o.get("protocol") not in PROXY:
        raise ValueError("اوت‌باند پروکسی به اسم %s پیدا نشد" % name)
    cur, _ = addr_of(o)
    base, via = split(cur)
    every = tunnels()
    tuns = [t for t in every if t["routed"] and t["peer"]]
    here = next((t for t in every if t["iface"] == via), None) if via else next((t for t in tuns if t["peer"] == base), None)
    same = lambda t: bool(here and t["far_ip"] and t["far_ip"] == here["far_ip"])
    tries = {t["peer"]: {"addr": t["peer"], "iface": t["iface"], "kind": t["kind"], "carrier": t["carrier"],
                         "far": t["far"], "same_server": same(t)} for t in tuns}
    for t in every:                          # the same address, carried by each sing-box tun
        if t["kind"] == "tun" and t["local"]:
            e = "%s@%s" % (base, t["iface"])
            tries[e] = {"addr": e, "iface": t["iface"], "kind": "sing-box", "carrier": "sing-box",
                        "far": t["far"], "same_server": same(t)}
    for a in extra:
        if ADDR_OK.match(a):
            tries.setdefault(a, {"addr": a, "iface": "", "kind": "manual", "carrier": "", "far": "", "same_server": False})
    tries.pop(cur, None)
    with ThreadPoolExecutor(max_workers=6) as pool:
        results = dict(zip(tries, pool.map(lambda a: test(name, a, cfg), list(tries))))
    found = []
    for a, meta in tries.items():
        r = results[a]
        found.append(dict(meta, ok=r["ok"], ms=r["ms"], at=r["at"]))
    found.sort(key=lambda x: (not x["ok"], not x["same_server"], x["ms"] or 99999))
    st = load(STATE, {})
    s = st.setdefault(name, {})
    s["scan"] = {"at": int(time.time()), "found": found}
    s.setdefault("tests", {}).update({x["addr"]: {"ok": x["ok"], "ms": x["ms"], "at": x["at"]} for x in found})
    save(STATE, st)
    good = [x["addr"] for x in found if x["ok"]]
    if save_found and good:
        c = conf()
        spec = c.setdefault("tunnels", {}).setdefault(name, {})
        have = spec.get("addrs") or [cur]
        spec["addrs"] = have + [a for a in good if a not in have]
        save(GUARD_CONF, c)
    return {"ok": True, "name": name, "current": cur, "found": found, "answered": good,
            "msg": ("%s روی %d آدرس دیگر هم جواب داد: %s" % (name, len(good), "، ".join(good)) if good
                    else "برای %s آدرس دیگری که جواب بدهد پیدا نشد (%d آدرس امتحان شد)" % (name, len(found)))}


def add_addr(name, addr):
    """One more address on NAME's list, typed by hand. Tested, but kept even when it does not
    answer yet: a tunnel being set up now can come up later, and auto skips what does not answer."""
    if not ADDR_OK.match(addr):
        raise ValueError("آدرس نامعتبر: " + addr)
    cfg = load(CFG, {})
    o = next((x for x in cfg.get("outbounds", []) if x.get("tag") == name), None)
    if not o:
        raise ValueError("اوت‌باند %s پیدا نشد" % name)
    cur, _ = addr_of(o)
    c = conf()
    order = [n for n in [c.get("primary")] + (c.get("backups") or []) if n]
    if name not in order:
        raise ValueError("%s در فهرست مسیرها نیست" % name)
    spec = c.setdefault("tunnels", {}).setdefault(name, {})
    have = spec.get("addrs") or [cur]
    if addr not in have:
        have.append(addr)
    spec["addrs"] = have
    save(GUARD_CONF, c)
    r = test(name, addr, cfg) if addr != cur else {"ok": True, "ms": None, "at": int(time.time())}
    st = load(STATE, {})
    st.setdefault(name, {}).setdefault("tests", {})[addr] = r
    save(STATE, st)
    return {"ok": True, "reachable": r["ok"], "ms": r["ms"],
            "msg": ("%s به %s اضافه شد و جواب داد (%s ms)" % (addr, name, r["ms"]) if r["ok"]
                    else "%s به %s اضافه شد ولی الان جواب نمی‌دهد؛ تا سالم نشود جابجایی خودکار سراغش نمی‌رود"
                    % (addr, name))}


def probe_live(name, cfg):
    """Is NAME answering right now, through its own guard probe port?"""
    port = next((i.get("port") for i in cfg.get("inbounds", []) if i.get("tag") == "guard-" + name.lower()), None)
    if not port:
        return None
    for _ in range(2):
        rc, out = run("curl", "-s", "-o", "/dev/null", "-m", "8", "--socks5-hostname", "127.0.0.1:%d" % port,
                      "-w", "%{http_code}", TEST_URL, timeout=12)
        if out.strip() not in ("000", ""):
            return True
        time.sleep(3)
    return False


# ---------------------------------------------------------------- moving an outbound

def use(name, addr, why="by hand"):
    if xuimix.spec_of(conf(), name):
        raise ValueError("%s روی چند تانل همزمان است؛ برای عوض کردن، تانل‌های ترکیب را عوض کنید یا ترکیب را خاموش کنید" % name)
    cfg = load(CFG, {})
    tags = [t for t in family(name) if any(o.get("tag") == t for o in cfg.get("outbounds", []))]
    if not tags:
        raise ValueError("اوت‌باند %s پیدا نشد" % name)
    old, _ = addr_of(next(o for o in cfg["outbounds"] if o["tag"] == name))
    if old == addr:
        return {"ok": True, "msg": "%s از قبل روی %s است" % (name, addr)}

    # 1. the panel's template, so the next x-ui restart keeps it
    db = xuidb.connect()
    t = template(db)
    for o in t.get("outbounds", []):
        if o.get("tag") in tags:
            set_addr(o, addr)
    db.execute("update settings set value=? where key=?", (json.dumps(t, indent=2), KEY))
    db.commit()
    db.close()

    # 2. the running Xray, through its API: swap the outbounds without a restart
    # ado appends: moving the first outbound would change Xray's default route, so restart then
    api, hot = api_addr(cfg), cfg["outbounds"][0].get("tag") not in tags
    for o in cfg["outbounds"]:
        if o.get("tag") not in tags:
            continue
        set_addr(o, addr)
        if not hot:
            continue
        fd, path = tempfile.mkstemp(suffix=".json")
        with os.fdopen(fd, "w") as f:
            json.dump({"outbounds": [o]}, f)
        run(XRAY, "api", "rmo", "--server=" + api, o["tag"])
        rc, out = run(XRAY, "api", "ado", "--server=" + api, path)
        os.remove(path)
        hot = hot and rc == 0
    save(CFG, cfg)                          # what the page, config-guard and the guard read
    if not hot:                             # the API refused: Xray alone is restarted, not the panel
        xuilive.restart_xray()
    run("config-guard", "--save", timeout=30)

    # 3. the guard pings the new peer, and watches an AWG handshake only when it is an AWG tunnel
    c = conf()
    plain, via = split(addr)
    tun = next((x for x in tunnels() if (x["iface"] == via if via else x["peer"] == plain)), {})
    for n in tags:
        p = c.setdefault("paths", {}).setdefault(n, {})
        if n == name:
            p.pop("iface", None)
            p.pop("tun", None)
            if via:                          # through sing-box: time the round trip through its tun
                p["peer"], p["tun"] = "", via
            else:
                p["peer"] = plain
                if tun.get("kind") in ("wireguard", "amneziawg"):
                    p["iface"] = tun["iface"]
    save(GUARD_CONF, c)

    st = load(STATE, {})
    s = st.setdefault(name, {})
    s.update(last_switch=int(time.time()), fails=0, back_oks=0)
    s.setdefault("events", []).append({"t": int(time.time()), "from": old, "to": addr, "why": why})
    s["events"] = s["events"][-20:]
    save(STATE, st)
    if why == "by hand":                    # a person chose: the timer keeps the list order from now on
        c = conf()
        spec = c.setdefault("tunnels", {}).setdefault(name, {})
        if spec.get("order", "auto") != "manual":
            spec["order"] = "manual"
            save(GUARD_CONF, c)
    log("%s: %s -> %s (%s)%s" % (name, old, addr, why, "" if hot else " - via x-ui restart"))
    return {"ok": True, "msg": "%s از %s به %s رفت%s" % (name, old, addr, "" if hot else " (با ری‌استارت x-ui)")}


