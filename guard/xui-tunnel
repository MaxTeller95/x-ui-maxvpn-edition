def xray_ok(t):
    """Would Xray start from this template? The same merge x-ui does, over the live inbounds."""
    cfg = load(CFG, {})
    for k in ("outbounds", "routing", "api", "dns", "policy", "burstObservatory", "observatory"):
        if k in t:
            cfg[k] = t[k]
        else:
            cfg.pop(k, None) if k in ("burstObservatory", "observatory") else None
    fd, path = tempfile.mkstemp(suffix=".json", prefix="xui-tunnel-mix-")
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f)
    try:
        r = subprocess.run([XRAY, "run", "-test", "-c", path], cwd=BIN, capture_output=True, text=True, timeout=60)
        out = (r.stdout + r.stderr).strip().splitlines()
        return r.returncode == 0, (out[-1] if out else "")
    finally:
        os.remove(path)


def write_template(t):
    db = xuidb.connect()
