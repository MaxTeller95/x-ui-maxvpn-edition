def rescan_all():
    """Once an hour: look again for addresses that carry each path (a tunnel may be new)."""
    st = load(STATE, {})
    if time.time() - st.get("_scan_at", 0) < SCAN_EVERY:
        return
    st["_scan_at"] = int(time.time())
    save(STATE, st)
    c, cfg = conf(), load(CFG, {})
    outs = {o.get("tag"): o for o in cfg.get("outbounds", [])}
    before = {n: {x["addr"] for x in ((st.get(n) or {}).get("scan") or {}).get("found", []) if x.get("ok")}
              for n in outs}
    for name in [n for n in [c.get("primary")] + (c.get("backups") or []) if n]:
        if (outs.get(name) or {}).get("protocol") not in PROXY:
            continue
        try:
            r = scan(name)
        except ValueError:
            continue
        new = [a for a in r["answered"] if a not in before.get(name, set())
               and a not in ((c.get("tunnels") or {}).get(name) or {}).get("addrs", [])]
        if new:
            log("%s: new addresses answer: %s" % (name, ", ".join(new)))


def auto():
    c, st = conf(), load(STATE, {})
    now, due = int(time.time()), []
    for name, spec in (c.get("tunnels") or {}).items():
        mx = xuimix.spec_of(c, name)
        if mx:
            try:
                watch_loss(name, mx, st)
            except Exception as e:                       # never let a measurement stop the timer
                log("%s: loss check failed: %s" % (name, e))
            watch_mix(name, mx, st, now)
            continue
        addrs = spec.get("addrs") or []
        if not spec.get("auto") or len(addrs) < 2:
            continue
        cfg = load(CFG, {})
        o = next((x for x in cfg.get("outbounds", []) if x.get("tag") == name), None)
        if not o:
            continue
        cur, _ = addr_of(o)
        s = st.setdefault(name, {})
        tests = s.setdefault("tests", {})
        try:
            track_loss(addrs, s)
        except Exception as e:                           # never let a measurement stop the timer
            log("%s: loss check failed: %s" % (name, e))
        if now - s.get("up_at", 0) >= UP_EVERY:
            due.append((name, addrs))
        smart = spec.get("order", "auto") != "manual" and measured(addrs, s)
        pref = ranked(addrs, s) if smart else addrs
        ok = probe_live(name, cfg)
        if ok is None:
            ok = test(name, cur, cfg)["ok"]
        tests[cur] = {"ok": ok, "at": now, "ms": None, "live": True}
        remember(s, cur, ok)
        if not ok:
            s["fails"] = s.get("fails", 0) + 1
            s["back_oks"] = 0
            if now - s.get("last_switch", 0) < SWITCH_GAP:
                continue
            for a in [x for x in pref if x != cur]:
                r = tests[a] = test(name, a, cfg)
                remember(s, a, r["ok"])
                if r["ok"]:
                    save(STATE, st)
                    use(name, a, "tunnel %s stopped answering" % cur)
                    st = load(STATE, {})
                    telegram("🔀 %s: تانل %s جواب نداد؛ اوت‌باند بدون قطع کاربران روی %s رفت (%d ms)."
                             % (name, cur, a, r["ms"] or 0))
                    break
            else:
                log("%s: %s is down and no other tunnel answered" % (name, cur))
            continue
        s["fails"] = 0
        if smart:
            if rank_move(name, cur, pref, st, cfg, now):
                st = load(STATE, {})
            continue
        better = addrs[:addrs.index(cur)] if cur in addrs else addrs
        if not better or now - s.get("last_switch", 0) < RETURN_GAP:
            continue
        r = tests[better[0]] = test(name, better[0], cfg)
        s["back_oks"] = s.get("back_oks", 0) + 1 if r["ok"] else 0
        if s["back_oks"] >= RETURN_OKS:
            save(STATE, st)
            use(name, better[0], "preferred tunnel healthy again")
            st = load(STATE, {})
            telegram("✅ %s: تانل ترجیحی %s سالم است؛ اوت‌باند به آن برگشت." % (name, better[0]))
    save(STATE, st)
    for name, addrs in due:          # after any move: a dead tunnel is left first, measured after
        try:
            st = load(STATE, {})
            measure_uploads(name, addrs, st.setdefault(name, {}))
            save(STATE, st)
        except Exception as e:
            log("%s: upload measurement failed: %s" % (name, e))
    try:
        steer(c, now)
    except Exception as e:
        log("heavy upload check failed: %s" % e)
    rescan_all()


