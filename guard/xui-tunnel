    db.close()


def mix_set(name, spec):
    """Turn NAME's mix on (spec) or off (None): test, back up, write the template, restart x-ui
    once and check the path still answers through its probe port - or put everything back."""
    c = conf()
    order = [n for n in [c.get("primary")] + (c.get("backups") or []) if n]
    if name not in order:
        raise ValueError("%s در فهرست مسیرها نیست" % name)
    if spec:
        bad = [a for a in spec["addrs"] if not ADDR_OK.match(a)]
        if bad:
            raise ValueError("آدرس نامعتبر: " + "، ".join(bad))
    old = template()
    new = json.loads(json.dumps(old))
    if spec:
        xuimix.build(new, name, spec)
    else:
        xuimix.remove(new, name)
    ok, detail = xray_ok(new)
    if not ok:
        raise ValueError("Xray این کانفیگ را قبول نکرد: " + detail)
    backup = "/root/xui-backup-" + time.strftime("%Y%m%d-%H%M%S")
    xuidb.backup_to(backup)
    shutil.copy2(CFG, backup)
    old_spec = json.loads(json.dumps(((c.get("tunnels") or {}).get(name) or {}).get("mix") or {}))
    entry = c.setdefault("tunnels", {}).setdefault(name, {})
    if spec:
        entry["mix"] = spec
        entry["addrs"] = list(dict.fromkeys((entry.get("addrs") or []) + spec["addrs"]))
    else:
        entry["mix"] = dict(old_spec, on=False)
    if not spec:                        # one tunnel again: the first of the mix, and the guard watches it
        first = (old_spec.get("addrs") or [None])[0]
        if first:
            for o in new["outbounds"]:
                if o.get("tag") in family(name):
                    set_addr(o, first)
    write_template(new)
    save(GUARD_CONF, c)
    run("config-guard", "--save", timeout=30)        # before config.json changes
    how = xuilive.apply(new, old)                    # live: users keep their connections and their bytes are billed
    time.sleep(3)
    answers = probe_live(name, load(CFG, {}))
    if answers is False:
        write_template(old)
        c = conf()
        c.setdefault("tunnels", {}).setdefault(name, {})["mix"] = old_spec
        save(GUARD_CONF, c)
        run("config-guard", "--save", timeout=30)
        xuilive.apply(old, new)
        raise ValueError("بعد از اعمال، %s از پورت probe جواب نداد؛ همه‌چیز برگردانده شد (بکاپ: %s)" % (name, backup))
    st = load(STATE, {})
    s = st.setdefault(name, {})
    s.setdefault("events", []).append({"t": int(time.time()), "from": "", "why": "mix",
                                       "to": ("ترکیب: " + " + ".join(spec["addrs"])) if spec else "تک‌تانل"})
    s["events"] = s["events"][-20:]
    for k in ("mix_down", "mix_out", "live_mix", "loss", "loss_pct"):
        s.pop(k, None)
    save(STATE, st)
    log("%s: mix %s" % (name, ("on " + ",".join(spec["addrs"]) + " " + spec["how"]) if spec else "off"))
    how_fa = {"smart": "هوشمند", "random": "تصادفی", "roundrobin": "نوبتی"}
    if spec:
        return {"ok": True, "backup": backup, "msg": "%s حالا همزمان روی %s است (%s)؛ %s" % (
            name, " و ".join(spec["addrs"]), how_fa[spec["how"]], "بدون ری‌استارت" if how == "live" else "Xray یک بار ری‌استارت شد")}
    return {"ok": True, "backup": backup, "msg": "%s دوباره روی یک تانل است (%s)؛ %s" % (
        name, (old_spec.get("addrs") or ["?"])[0], "بدون ری‌استارت" if how == "live" else "Xray یک بار ری‌استارت شد")}


def pinned(name, cfg=None):
    """The tunnel NAME's balancer is held on for now (xray api bo), or None."""
    cfg = cfg or load(CFG, {})
    rc, out = run(XRAY, "api", "bi", "--server=" + api_addr(cfg), "--json", xuimix.MIX + name, timeout=8)
    try:
        tag = ((json.loads(out).get("balancer") or {}).get("override") or {}).get("target") or ""
    except ValueError:
        return None
    if not tag:
        return None
    spec = (((conf().get("tunnels") or {}).get(name) or {}).get("mix") or {}).get("addrs") or []
    i = xuimix.copy_index(tag) - 1
    return spec[i] if 0 <= i < len(spec) else tag


def mix_pin(name, addr):
    """Hold NAME (and NAME-mux) on one tunnel of its mix, or let go (addr empty). Runtime only."""
    spec = xuimix.spec_of(conf(), name)
    if not spec:
        raise ValueError("%s ترکیبی نیست" % name)
    cfg = load(CFG, {})
    api = "--server=" + api_addr(cfg)
    fams = [f for f in (name, name + "-mux") if f in xuimix.mixed(cfg)]
    if not addr:
        for f in fams:
            run(XRAY, "api", "bo", api, "-b", xuimix.MIX + f, "-r", timeout=8)
        return {"ok": True, "msg": "%s دوباره بین همه‌ی تانل‌های ترکیب پخش می‌شود" % name}
    if addr not in spec["addrs"]:
        raise ValueError("%s جزو تانل‌های ترکیب %s نیست" % (addr, name))
    i = spec["addrs"].index(addr) + 1
    for f in fams:
        rc, out = run(XRAY, "api", "bo", api, "-b", xuimix.MIX + f, xuimix.copy_tag(f, i), timeout=8)
        if rc:
            raise ValueError("Xray قبول نکرد: " + out[-200:])
    return {"ok": True, "msg": "%s فعلاً فقط روی %s است (تا برداشتن سنجاق یا ری‌استارت x-ui)" % (name, addr)}


def watch_mix(name, spec, st, now):
    """A mix needs no moving - Xray skips a dead tunnel - but the page shows each tunnel's state
    and Telegram hears when one drops out of the mix or comes back."""
    s = st.setdefault(name, {})
    if now - s.get("mix_checked", 0) < MIX_CHECK:
        return
    s["mix_checked"] = now
    cfg = load(CFG, {})
    tests = s.setdefault("tests", {})
    down = set(s.get("mix_down") or [])
    for a in spec["addrs"]:
        r = tests[a] = test(name, a, cfg)
        if not r["ok"] and a not in down:
            down.add(a)
            telegram("⚠️ %s: تانل %s از ترکیب افتاد؛ Xray اتصال‌های تازه را به بقیه‌ی تانل‌ها می‌دهد." % (name, a))
        elif r["ok"] and a in down:
            down.discard(a)
            telegram("✅ %s: تانل %s دوباره جواب می‌دهد و به ترکیب برگشت." % (name, a))
    s["mix_down"] = sorted(down)
    if len(down) == len(spec["addrs"]):
        log("%s: no tunnel of the mix answers" % name)


# ---------------------------------------------------------------- packet loss inside a mix

def ping_loss(entry):
    """(sent, received, avg ms) for one tunnel: its far address, through its tun for ADDR@IFACE."""
    addr, via = split(entry)
    cmd = ["ping", "-n", "-q", "-c", str(LOSS_PINGS), "-i", LOSS_GAP, "-W", "1"] + (["-I", via] if via else []) + [addr]
    rc, out = run(*cmd, timeout=LOSS_PINGS * 0.1 + 6)
    m = re.search(r"(\d+) packets transmitted, (\d+) (?:packets )?received", out)
    rtt = re.search(r"= [\d.]+/([\d.]+)/", out)
    if not m:
        return None
    return int(m.group(1)), int(m.group(2)), float(rtt.group(1)) if rtt else None


def loss_pct(rounds):
    sent = sum(r[0] for r in rounds)
    return round(100.0 * sum(r[0] - r[1] for r in rounds) / sent, 1) if sent else None


def live_tags(cfg):
    rc, out = run(XRAY, "api", "lso", "--server=" + api_addr(cfg), timeout=15)
    try:
        return {o.get("tag") for o in json.loads(out).get("outbounds", [])}
    except ValueError:
        return None


def xray_pid():
    """The panel's own Xray (a child of x-ui) - not another xray on the box, like WGDashboard's."""
    rc, main = run("systemctl", "show", "-p", "MainPID", "--value", "x-ui", timeout=5)
    rc, out = run("pgrep", "-P", main.strip() or "0", "xray", timeout=5)
    return out.split()[0] if rc == 0 and out else ""


def live_mix(name, spec, out, s, cfg=None):
    """Make the running Xray carry NAME's mix without the tunnels in `out`: their copies go, and
    when the first tunnel (the balancer's fallback) is out its copy stays but is aimed at the
    best tunnel left, so the fallback always exists. Only what differs is touched; what was done
    is remembered per Xray process, so a restart (which brings the template back) is redone."""
    cfg = cfg or load(CFG, {})
    api = "--server=" + api_addr(cfg)
    live = live_tags(cfg)
    if live is None:
        return False
    pid = xray_pid()
    if s.get("live_pid") != pid:
        s["live_pid"], s["live_mix"] = pid, {}
    done = s.setdefault("live_mix", {})
    keep = [a for a in spec["addrs"] if a not in out]
    changed = False
    for f in (name, name + "-mux"):
        copies = [o for o in cfg.get("outbounds", []) if xuimix.is_clone(o.get("tag")) and xuimix.base_of(o["tag"]) == f]
        for o in copies:
            i = xuimix.copy_index(o["tag"]) - 1
            addr = spec["addrs"][i] if i < len(spec["addrs"]) else None
            fallback = o["tag"] == xuimix.copy_tag(f, 1)
            gone = addr in out and not fallback
            aim = keep[0] if (addr in out and fallback) else addr
            live_now = o["tag"] in live
            if gone:
                if live_now:
                    run(XRAY, "api", "rmo", api, o["tag"], timeout=10)
                    changed = True
                done.pop(o["tag"], None)
                continue
            # as the template has it (and as a restart brings it) unless we aimed it elsewhere
            if live_now and done.get(o["tag"], addr) == aim:
                continue
            want = json.loads(json.dumps(o))
            set_addr(want, aim)
            fd, path = tempfile.mkstemp(suffix=".json")
            with os.fdopen(fd, "w") as fh:
                json.dump({"outbounds": [want]}, fh)
            if live_now:
                run(XRAY, "api", "rmo", api, o["tag"], timeout=10)
            rc, _ = run(XRAY, "api", "ado", api, path, timeout=10)
            os.remove(path)
            if rc:
                return changed
            done[o["tag"]] = aim
            changed = True
    return changed


def watch_loss(name, spec, st):
    s = st.setdefault(name, {})
    with ThreadPoolExecutor(max_workers=len(spec["addrs"])) as ex:
        got = dict(zip(spec["addrs"], ex.map(ping_loss, spec["addrs"])))
    hist = s.setdefault("loss", {})
    for a in list(hist):
        if a not in spec["addrs"]:
            hist.pop(a)
    for a, r in got.items():
        if r:
            hist.setdefault(a, []).append([r[0], r[1]])
            hist[a] = hist[a][-LOSS_WINDOW:]
            s.setdefault("rtt", {})[a] = r[2]
    out = [a for a in s.get("mix_out") or [] if a in spec["addrs"]]
    pct = {a: loss_pct(hist.get(a) or []) for a in spec["addrs"]}
    enough = {a: len(hist.get(a) or []) >= LOSS_MIN_ROUNDS for a in spec["addrs"]}
    known = [pct[a] for a in spec["addrs"] if pct[a] is not None and enough[a]]
    best = min(known) if known else None
    note = lambda a: "%s٪" % pct[a] if pct[a] is not None else "?"
    # back in: clean for the last few rounds
    for a in list(out):
        last = (hist.get(a) or [])[-LOSS_BACK_ROUNDS:]
        if len(last) == LOSS_BACK_ROUNDS and sum(x[0] - x[1] for x in last) <= 1:
            out.remove(a)
            hist[a] = last                           # judged afresh from its clean minutes, or it would bounce
            telegram("✅ %s: پکت لاست تانل %s برطرف شد؛ دوباره در ترکیب است." % (name, a))
            log("%s: %s back in the mix (clean)" % (name, a))
    pct = {a: loss_pct(hist.get(a) or []) for a in spec["addrs"]}              # after any return
    enough = {a: len(hist.get(a) or []) >= LOSS_MIN_ROUNDS for a in spec["addrs"]}
    known = [pct[a] for a in spec["addrs"] if pct[a] is not None and enough[a]]
    best = min(known) if known else None
    # out: clearly worse than its siblings, and a clean one stays
    for a in spec["addrs"]:
        if a in out or best is None or not enough[a] or pct[a] is None:
            continue
        clean_left = [b for b in spec["addrs"] if b != a and b not in out and enough[b]
                      and pct[b] is not None and pct[b] < LOSS_BAD]
        if pct[a] >= LOSS_BAD and pct[a] >= best + LOSS_MARGIN and clean_left:
            out.append(a)
            telegram("⚠️ %s: تانل %s در %d دقیقه‌ی اخیر %s پکت لاست داشت (بهترین: %s)؛ موقتاً از ترکیب بیرون رفت و "
                     "اتصال‌های تازه روی %s است." % (name, a, len(hist[a]), note(a), note(clean_left[0]),
                                                    " و ".join(b for b in spec["addrs"] if b not in out)))
            log("%s: %s out of the mix, loss %s%% (best %s%%)" % (name, a, pct[a], best))
    if known and len(known) == len(spec["addrs"]) and min(known) >= LOSS_BAD:
        if time.time() - s.get("loss_all_told", 0) > 3600:
            s["loss_all_told"] = int(time.time())
            telegram("⚠️ %s: همه‌ی تانل‌ها پکت لاست دارند (%s)؛ مشکل از بعد از تانل‌هاست و چیزی کنار گذاشته نشد."
                     % (name, "، ".join("%s %s" % (a, note(a)) for a in spec["addrs"])))
    s["mix_out"] = out
    s["loss_pct"] = pct
    live_mix(name, spec, out, s)
    return out


def set_order(name, order):
    if order not in ("auto", "manual"):
        raise ValueError("ترتیب: auto یا manual")
    c = conf()
    spec = (c.get("tunnels") or {}).get(name)
    if spec is None:
        raise ValueError("%s تانلی در فهرست ندارد" % name)
    spec["order"] = order
    save(GUARD_CONF, c)
    return {"ok": True, "msg": "ترتیب تانل‌های %s: %s" % (
        name, "خودکار (بر اساس سرعت آپلود، پکت لاست و پایداری)" if order == "auto" else "دستی (همان ترتیب فهرست)")}


def upload_now(name, addr=None):
    c, st = conf(), load(STATE, {})
    addrs = [addr] if addr else (((c.get("tunnels") or {}).get(name) or {}).get("addrs") or [])
    if not addrs:
        raise ValueError("%s تانلی در فهرست ندارد" % name)
    s = st.setdefault(name, {})
    keep = s.get("up_at")
    measure_uploads(name, addrs, s, force=True)
    if addr:
        s["up_at"] = keep or s["up_at"]
    save(STATE, st)
    rows = [dict(score(s, a), addr=a, last=((s.get("up") or {}).get(a) or [[0, None]])[-1][1]) for a in addrs]
    return {"ok": True, "rows": rows, "msg": "، ".join("%s: %s" % (r["addr"], "%s Mbit/s" % r["last"] if r["last"]
                                                                    else "نشد") for r in rows)}


def steer_view():
    st, c = load(STATE, {}), conf()
    u = st.get("_users") or {}
    return {"on": c.get("steer") is not False, "limit": float(c.get("heavy_up_mbps") or HEAVY_MBPS),
            "moved": st.get("_steer") or {}, "to": {n: a for n, (a, _) in (u.get("applied") or {}).items()},
            "total_mbps": u.get("total_mbps"), "top": u.get("top") or [], "log": (st.get("_steer_log") or [])[-5:]}


def set_addrs(name, addrs, auto_flag):
    c = conf()
    order = [n for n in [c.get("primary")] + (c.get("backups") or []) if n]
    if name not in order:
        raise ValueError("%s در فهرست مسیرها نیست" % name)
    bad = [a for a in addrs if not ADDR_OK.match(a)]
    if bad:
        raise ValueError("آدرس نامعتبر: " + "، ".join(bad))
    spec = c.setdefault("tunnels", {}).setdefault(name, {})
    if addrs:
        spec["addrs"] = list(dict.fromkeys(addrs))
    if auto_flag is not None:
        spec["auto"] = auto_flag
    if not spec.get("addrs"):
        c["tunnels"].pop(name, None)
    save(GUARD_CONF, c)
    return {"ok": True, "msg": "تانل‌های %s: %s%s" % (name, "، ".join(spec.get("addrs") or ["—"]),
                                                     " · جابجایی خودکار روشن" if spec.get("auto") else "")}


def main():
    args = sys.argv[1:]
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    auto_flag = None
    if "--auto" in args:
        i = args.index("--auto")
        auto_flag = (args[i + 1:i + 2] or ["on"])[0] == "on"
        del args[i:i + 2]
    mode = args[0] if args else "list"
    out = lambda d, text: print(json.dumps(d, ensure_ascii=False) if as_json else text)
    try:
        if mode == "discover":
            d = discover()
            out(d, "\n".join("%-8s %-10s %-15s -> %-15s far %-16s %-22s %s" % (
                t["iface"], t["kind"], t["local"], t["peer"] or "-", t["far"] or "?", t["carrier"],
                ",".join(t["paths"])) for t in d))
        elif mode == "list":
            d = listing()
            out(d, "\n".join("%-12s %-15s %s%s" % (r["name"], r["current"], " ".join(
                ("*" if a["live"] else "") + a["addr"] for a in r["addrs"]) or "-",
                "  auto" if r["auto"] else "") for r in d))
        elif mode == "set" and len(args) >= 2:
            d = set_addrs(args[1], [a for a in (args[2] if len(args) > 2 else "").split(",") if a], auto_flag)
            out(d, d["msg"])
        elif mode == "scan" and len(args) >= 2:
            d = scan(args[1], "--save" in args, [a for a in (args[2] if len(args) > 2 and not
                                                       args[2].startswith("--") else "").split(",") if a])
            out(d, "\n".join("%s %-16s %-8s %s" % ("ok " if x["ok"] else "-- ", x["addr"], x["iface"],
                                                    "%s ms" % x["ms"] if x["ok"] else "") for x in d["found"])
                + "\n" + d["msg"])
        elif mode == "add" and len(args) >= 3:
            d = add_addr(args[1], args[2])
            out(d, d["msg"])
        elif mode == "use" and len(args) >= 3:
            r = test(args[1], args[2])
            if not r["ok"] and "--force" not in args:
                raise ValueError("%s از آدرس %s جواب نداد؛ جابجا نشد" % (args[1], args[2]))
            d = use(args[1], args[2])
            out(d, d["msg"])
        elif mode == "test" and len(args) >= 3:
            d = test(args[1], args[2])
            st = load(STATE, {})
            st.setdefault(args[1], {}).setdefault("tests", {})[args[2]] = d
            save(STATE, st)
            out(dict(d, ok=True, reachable=d["ok"]), "ok %s ms" % d["ms"] if d["ok"] else "no answer")
        elif mode == "auto":
            auto()
        elif mode == "order" and len(args) >= 3:
            d = set_order(args[1], args[2])
            out(d, d["msg"])
        elif mode == "upload" and len(args) >= 2:
            d = upload_now(args[1], args[2] if len(args) > 2 else None)
            out(d, d["msg"])
        elif mode == "steer":
            if len(args) >= 2 and args[1] in ("on", "off"):
                c = conf()
                c["steer"] = args[1] == "on"
                save(GUARD_CONF, c)
            d = steer_view()
            out(d, "heavy upload moving %s (%s Mbit/s); moved now: %s" % (
                "on" if d["on"] else "off", d["limit"], ", ".join(d["moved"]) or "nobody"))
        elif mode == "mix" and len(args) >= 2:
            name, sub = args[1], (args[2] if len(args) > 2 else "")
            opt = lambda k, d=None: args[args.index(k) + 1] if k in args and args.index(k) + 1 < len(args) else d
            if sub == "on":
                spec = xuimix.clean_spec([a for a in (args[3] if len(args) > 3 else "").split(",") if a],
                                         opt("--how", "smart"), [w for w in (opt("--weights", "") or "").split(",") if w])
                d = mix_set(name, spec)
            elif sub == "off":
                d = mix_set(name, None)
            elif sub == "pin":
                a = args[3] if len(args) > 3 else ""
                d = mix_pin(name, "" if a in ("", "none", "off") else a)
            else:
                row = next((r for r in listing() if r["name"] == name), None)
                if not row:
                    raise ValueError("%s در فهرست مسیرها نیست" % name)
                d, m = row["mix"], row["mix"]
                out(d, "%s: %s%s" % (name, ("mixed (%s) over %s" % (m["how"], ", ".join(
                    "%s x%d" % (a, w) for a, w in zip(m["addrs"], m["weights"] or [1] * len(m["addrs"]))))) if m["on"]
                    else "one tunnel at a time", ("  pinned to " + m["pinned"]) if m.get("pinned") else ""))
                return
            out(d, d["msg"])
        else:
            print(__doc__)
            sys.exit(2)
    except ValueError as e:
        out({"ok": False, "msg": str(e)}, str(e))
        sys.exit(1)


if __name__ == "__main__":
    if os.geteuid() != 0:
        sys.exit("run this as root")
    if not XRAY:
        sys.exit("xray not found in " + BIN)
    main()
