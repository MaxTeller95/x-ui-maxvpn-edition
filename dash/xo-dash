IDLE_DAYS = 30


def is_idle(r):
    """Enabled, seen at least once, not seen for IDLE_DAYS, and not online right now."""
    return r["enable"] and r["last"] and not r["on"] and time.time() - r["last"] > IDLE_DAYS * 86400


def panel_api(cookie, path, body):
    """Call the panel's own API as the person using this page: their session cookie, and
    the CSRF token the panel mints for that session (3.x checks it on unsafe requests)."""
    root = "https://127.0.0.1:%s%s" % (setting("webPort") or 2053, BASE)
    head = {"Cookie": cookie, "X-Requested-With": "XMLHttpRequest", "Accept": "application/json"}
    for p in ("panel/csrf-token", "csrf-token"):
        try:
            got = json.loads(_opener.open(urllib.request.Request(root + p, headers=head), timeout=10).read())
        except Exception:
            continue
        if got.get("success") and isinstance(got.get("obj"), str):
            head["X-CSRF-Token"] = got["obj"]
            break
    req = urllib.request.Request(root + path, data=json.dumps(body).encode(), method="POST",
                                 headers=dict(head, **{"Content-Type": "application/json"}))
    try:
        return json.loads(_opener.open(req, timeout=180).read())
    except urllib.error.HTTPError as e:
        return {"success": False, "msg": "پنل پاسخ %d داد" % e.code}


def delete_idle(cookie, emails, everyone):
    """Delete idle clients through the panel, never anyone who is not idle by the time it runs."""
    idle = {r["email"] for r in users_rows() if is_idle(r)}
    want = sorted(idle) if everyone else [e for e in emails if e in idle]
    skipped = [e for e in emails if e not in idle] if not everyone else []
    if not want:
        return {"ok": False, "msg": "کاربر خاموشی برای حذف نماند" + (" (دیگر خاموش نیستند: %s)" % "، ".join(skipped)
                                                                   if skipped else "")}
    backup = os.path.basename(make_backup())               # a way back before anything goes
    r = panel_api(cookie, "panel/api/clients/bulkDel", {"emails": want, "keepTraffic": False})
    if not r.get("success"):
        return {"ok": False, "msg": "پنل حذف نکرد: %s (بکاپ: %s)" % (r.get("msg") or "?", backup)}
    obj = r.get("obj") or {}
    gone = obj.get("deleted", len(want)) if isinstance(obj, dict) else len(want)
    skipped += ["%s (%s)" % (x.get("email"), x.get("reason")) for x in (obj.get("skipped") or [])
                if isinstance(x, dict)] if isinstance(obj, dict) else []
    msg = "%d کاربر خاموش حذف شد. بکاپ قبل از حذف: %s" % (gone, backup)
    if skipped:
        msg += " · حذف نشد: " + "، ".join(skipped[:8])
    return {"ok": True, "msg": msg, "deleted": gone, "backup": backup}


