def outages(st, c):
    """Recent outages, told apart: over, still going, answering again but not yet trusted
    (the guard waits for a few healthy runs), or the path was removed while it was down."""
    known, last = set(c.get("paths") or {}), st.get("last") or {}
    out = []
    for o in sorted(st.get("outages", []), key=lambda o: -o["start"])[:8]:
        o = dict(o)
        if "end" in o:
            o["state"] = "over"
        elif o.get("removed") or o["path"] not in known:
            o["state"] = "removed"
        elif (last.get(o["path"]) or {}).get("ok"):
            o["state"] = "recovering"
        else:
            o["state"] = "ongoing"
        out.append(o)
    return out


_split_cache = [0, None]


def split_check():
    """xui-split check, at most once a minute (it asks the running Xray too)."""
    if time.time() - _split_cache[0] > 60:
        _split_cache[:] = [time.time(), jrun("xui-split", "check", "--json", timeout=30)]
    return _split_cache[1]


_slow = {}


def cached(key, secs, fn):
    """A slow helper (a tool run) at most once per `secs`."""
    hit = _slow.get(key)
    if not hit or time.time() - hit[0] > secs:
        _slow[key] = hit = (time.time(), fn())
    return hit[1]


def quic_share(lines=20000):
    """How much of the users' traffic is QUIC (UDP 443), from the tail of the access log - and,
    with the block on, how much of it was refused and retried over TCP."""
    rc, out = run("tail", "-n", str(lines), access_log(), timeout=15)
    total = quic = refused = 0
    for l in out.splitlines():
        if " accepted " not in l or "[api" in l or "guard-" in l:
            continue
        total += 1
        m = re.search(r" accepted udp:\S+:443 \[[^\]]*->\s*(\S+)\]", l)
        if m:
            quic += 1
            refused += m.group(1) in ("blocked", "block", "blackhole")
    return {"total": total, "quic": quic, "refused": refused, "pct": round(100.0 * quic / total, 1) if total else 0}


def speed_by_inbound(hours=24):
    """The fastest real transfer each user reached (5-second average), grouped by the inbound
    they connect through - so two transports (say WebSocket on 80 and TLS on 443) can be
    compared on the same users' own networks. Users on several inbounds are kept apart."""
    peaks = METRICS.peak_by_user(hours)
    with db() as c:
        where = collections.defaultdict(set)
        for email, tag in c.execute("select cl.email, i.tag from client_inbounds ci join clients cl on cl.id = ci.client_id "
                                    "join inbounds i on i.id = ci.inbound_id"):
            where[email].add(tag)
        meta = {r["tag"]: dict(r) for r in c.execute("select tag, remark, port, protocol, stream_settings from inbounds")}
    groups = collections.defaultdict(lambda: {"up": [], "down": []})
    for email, (up, dn) in peaks.items():
        tags = where.get(email) or set()
        key = next(iter(tags)) if len(tags) == 1 else "*multi"
        if up:
            groups[key]["up"].append(up)
        if dn:
            groups[key]["down"].append(dn)

    def spread(v):
        v = sorted(v)
        pick = lambda q: v[min(len(v) - 1, int(q * len(v)))]
        return {"n": len(v), "p50": pick(0.5), "p90": pick(0.9), "max": v[-1]} if v else {"n": 0}

    rows = []
    for key, g in groups.items():
        m = meta.get(key) or {}
        try:
            ss = json.loads(m.get("stream_settings") or "{}")
        except ValueError:
            ss = {}
        rows.append({"inbound": key, "remark": m.get("remark") or ("چند اینباند" if key == "*multi" else key),
                     "port": m.get("port"), "protocol": m.get("protocol", ""),
                     "network": ss.get("network", ""), "security": ss.get("security", "none"),
                     "users": len([e for e, t in where.items() if key in t or (key == "*multi" and len(t) > 1)]),
                     "up": spread(g["up"]), "down": spread(g["down"])})
    rows.sort(key=lambda r: -r["up"].get("n", 0))
    return {"hours": hours, "rows": rows, "sample_secs": Metrics.STEP}


def reach_view():
    """The last round of xui-reach (from its history file; the tool itself runs on a timer)."""
    h = json.loads(read("/var/lib/xui-reach/history.json", "{}") or "{}")
    rounds = h.get("rounds") or []
    if not rounds:
        return {"installed": os.path.exists("/usr/local/sbin/xui-reach"), "last": None}
    last = rounds[-1]
    trend = {}
    for r in rounds[-36:]:                                 # 6 hours at one round per 10 minutes
        for p, got in r.get("res", {}).items():
            ok = [v for v in got.values() if v not in (None, "x")]
            trend.setdefault(p, []).append([r["t"], len(ok), len([v for v in got.values() if v is not None])])
    return {"installed": True, "last": last, "trend": trend, "down": h.get("down", {})}


def status():
    st = json.loads(read(GUARD_STATE, "{}") or "{}")
    c, cfg = conf(), xray_cfg()
    rules = cfg.get("routing", {}).get("rules", [])
    tags = {r.get("ruleTag") for r in rules}
    rc, _ = run("systemctl", "is-active", "tunnel-guard.timer", timeout=10)
    order = [c.get("primary")] + (c.get("backups") or [c.get("backup")])
    avail = availability()
    return {
        "paths": [dict(name=n, role="primary" if i == 0 else "backup %d" % i,
