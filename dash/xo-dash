#!/usr/bin/env python3
"""xo-dash - the Optimizer page shown inside the x-ui panel.

Listens on 127.0.0.1 only. nginx serves it under <panel base path>xo-dash/ and adds an
"Optimizer" item to the panel's sidebar (see install-dash.sh). Every request is checked
against the panel's own login: the browser's panel cookie is replayed to the panel, and
only a logged-in session gets through.

Besides the switches, a background collector reads Xray's stats API every 5 s and keeps
one bucket per minute for 24 h in /var/lib/xo-dash/history.json, so the page can show
live throughput per path, per inbound and per user without touching the panel's database.
"""
import collections, http.server, json, os, re, shutil, ssl, subprocess, threading, time, urllib.parse, urllib.request, sys
