def lint():
    """Checks the invariants this panel has to keep; every finding says how to repair it."""
    found, cfg = [], xray_cfg()

    def add(level, title, detail, fix=None):
        found.append({"level": level, "title": title, "detail": detail, "fix": fix})

    with db() as c:
        inbounds = {r["id"]: dict(r) for r in c.execute("select id, tag, remark, settings, stream_settings from inbounds")}
        clients = {r["id"]: dict(r) for r in c.execute("select id, email, uuid, enable, sub_id from clients")}
        links = [dict(r) for r in c.execute("select client_id, inbound_id, flow_override from client_inbounds")]
        traffic = {r[0] for r in c.execute("select email from client_traffics")}

    listed = {}
    for i in inbounds.values():
        try:
            listed[i["id"]] = {x.get("email"): x for x in (json.loads(i["settings"] or "{}").get("clients") or [])}
        except Exception:
            listed[i["id"]] = {}

    missing, noflow = [], []
    for l in links:
        cl, inb = clients.get(l["client_id"]), inbounds.get(l["inbound_id"])
        if not cl or not inb:
            continue
        entry = listed.get(inb["id"], {}).get(cl["email"])
        if not entry or not entry.get("id"):
            missing.append("%s@%s" % (cl["email"], inb["tag"]))
        elif (entry.get("flow") or "") != (l["flow_override"] or ""):  # link and listener must agree
            noflow.append("%s@%s" % (cl["email"], inb["tag"]))

    linked = {(l["client_id"], l["inbound_id"]) for l in links}
    by_email = {c["email"]: c["id"] for c in clients.values()}
    ghosts = ["%s@%s" % (email, inbounds[iid]["tag"]) for iid, entries in listed.items() for email in entries
              if (by_email.get(email), iid) not in linked]

    if missing:
        add("bad", "کلاینت‌هایی که در لیست داخلی اینباند نیستند",
            "هنگام ویرایش، پنل خطای empty client ID می‌دهد. %d مورد: %s" % (len(missing), "، ".join(missing[:6])),
            "fix-inbounds")
    if ghosts:
        add("warn", "ردیف اضافی در لیست داخلی اینباند",
            "%d ردیف در لیست قدیمی اینباند هست ولی کلاینتی به آن وصل نیست: %s" % (len(ghosts), "، ".join(ghosts[:6])),
            "fix-inbounds")
    if noflow:
        add("bad", "ناهماهنگی flow",
            "flow در لینک کاربر با چیزی که اینباند قبول می‌کند یکی نیست، پس اتصال رد می‌شود: " + "، ".join(noflow[:6]),
            "fix-inbounds")

    orphan = traffic - set(by_email)
    if orphan:
        add("warn", "ردیف ترافیک بدون کلاینت",
            "%d ردیف در client_traffics به هیچ کلاینتی وصل نیست: %s" % (len(orphan), "، ".join(list(orphan)[:6])))
    dup_e = [e for e, n in collections.Counter(c["email"] for c in clients.values()).items() if n > 1]
    dup_u = [u for u, n in collections.Counter(c["uuid"] for c in clients.values() if c["uuid"]).items() if n > 1]
    if dup_e or dup_u:
        add("bad", "ایمیل یا UUID تکراری",
            "ایمیل: %s | UUID: %s" % ("، ".join(dup_e[:5]) or "-", "، ".join(dup_u[:3]) or "-"))
    lonely = [c["email"] for cid, c in clients.items() if not any(l["client_id"] == cid for l in links)]
    if lonely:
        add("warn", "کلاینت بدون اینباند",
            "%d کلاینت به هیچ اینباندی وصل نیست، پس لینک اشتراکشان خالی است: %s" % (len(lonely), "، ".join(lonely[:6])))
    nosub = [c["email"] for c in clients.values() if not (c["sub_id"] or "").strip()]
    if nosub:
        add("warn", "کلاینت بدون subId",
            "%d کلاینت لینک اشتراک ندارد: %s" % (len(nosub), "، ".join(nosub[:6])))

    rules = [r.get("ruleTag") for r in cfg.get("routing", {}).get("rules", [])]
    ir = [i for i, t in enumerate(rules) if t and t.startswith("ir-direct")]
    if ir and "dns-upstream" in rules and max(ir) > rules.index("dns-upstream"):
        add("bad", "ترتیب قانون‌های مسیریابی",
            "قانون‌های ir-direct باید بالاتر از dns-upstream باشند، وگرنه DNS سایت‌های ایرانی هم از تانل می‌رود.")
    outs = {o.get("tag", "").lower() for o in cfg.get("outbounds", [])}
    orphan_probes = [i["tag"] for i in cfg.get("inbounds", [])
                     if (i.get("tag") or "").startswith("guard-") and i["tag"][6:] not in outs]
    if orphan_probes:
        add("warn", "پورت probe بدون اوت‌باند",
            "اوت‌باند این‌ها حذف شده ولی پورتشان مانده و ترافیکش به اوت‌باند پیش‌فرض می‌رود: "
            + "، ".join(orphan_probes), "prune-probes")
    sc = split_check() or {}
    if sc.get("problems"):
        add("bad" if any(p["code"] in ("mux-off", "mux-missing", "live-mux-off", "rule-order") for p in sc["problems"])
            else "warn", "تقسیم ترافیک ناقص است", "؛ ".join(p["msg"] for p in sc["problems"][:3]), "split-fix")
    if not setting("remarkTemplate"):
        add("warn", "قالب نام کانفیگ‌ها",
            "remarkTemplate خالی است؛ پنل نام پیش‌فرض با ایمیل و حجم می‌سازد. مقدار {{INBOUND}} یعنی فقط نام اینباند.")
    return {"findings": found, "ok": not found,
            "counts": {"clients": len(clients), "links": len(links), "inbounds": len(inbounds)}}


