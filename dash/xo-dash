def resources():
    load = (read("/proc/loadavg", "0 0 0").split() + ["0"] * 3)[:3]
    mem = {}
    for line in read("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        mem[k] = int(v.split()[0]) * 1024 if v.split() else 0
    st = os.statvfs("/")
    estab = 0
    for line in run("ss", "-s", timeout=5)[1].splitlines():
        if line.startswith("TCP:") and "estab" in line:
            try:
                estab = int(line.split("estab")[1].split(",")[0].strip())
            except ValueError:
                pass
    ct = read("/proc/sys/net/netfilter/nf_conntrack_count", "0").strip() or "0"
    ctmax = read("/proc/sys/net/netfilter/nf_conntrack_max", "0").strip() or "0"
    return {
        "load": [float(x) for x in load], "cpus": os.cpu_count() or 1,
        "mem_total": mem.get("MemTotal", 0), "mem_avail": mem.get("MemAvailable", 0),
        "disk_total": st.f_blocks * st.f_frsize, "disk_free": st.f_bavail * st.f_frsize,
        "conns": estab, "conntrack": int(ct), "conntrack_max": int(ctmax),
        "uptime": int(float((read("/proc/uptime", "0").split() or ["0"])[0])),
    }


def vnstat_month():
    """This month's traffic per tunnel interface, from vnstat."""
    out = {}
    for name, p in (conf().get("paths") or {}).items():
        if not p.get("iface"):
            continue
        d = jrun("vnstat", "--json", "m", "-i", p["iface"], timeout=8)
        try:
            last = d["interfaces"][0]["traffic"]["month"][-1]
            out[name] = {"iface": p["iface"], "rx": last["rx"], "tx": last["tx"]}
        except Exception:
            continue
    return out


def backups():
    got = []
    try:
        for n in os.listdir(BACKUP_DIR):
            if not n.startswith("xui-backup-"):
                continue
            p = os.path.join(BACKUP_DIR, n)
            size = os.path.getsize(p) if os.path.isfile(p) else sum(
                os.path.getsize(os.path.join(p, f)) for f in os.listdir(p) if os.path.isfile(os.path.join(p, f)))
            got.append({"name": n, "at": int(os.path.getmtime(p)), "size": size})
    except OSError:
        pass
    return sorted(got, key=lambda b: -b["at"])[:12]


def inbound_rows():
    with db() as c:
        return [dict(r) for r in c.execute("select id, tag, remark, port, protocol, stream_settings, settings from inbounds")]


def outages(st, c):
    """Recent outages, told apart: over, still going, answering again but not yet trusted
    (the guard waits for a few healthy runs), or the path was removed while it was down."""
    known, last = set(c.get("paths") or {}), st.get("last") or {}
    out = []
    for o in sorted(st.get("outages", []), key=lambda o: -o["start"])[:8]:
        o = dict(o)
        if "end" in o:
            o["state"] = "over"
        elif o.get("removed") or o["path"] not in known:
            o["state"] = "removed"
        elif (last.get(o["path"]) or {}).get("ok"):
            o["state"] = "recovering"
        else:
            o["state"] = "ongoing"
        out.append(o)
    return out


_split_cache = [0, None]


def split_check():
    """xui-split check, at most once a minute (it asks the running Xray too)."""
    if time.time() - _split_cache[0] > 60:
        _split_cache[:] = [time.time(), jrun("xui-split", "check", "--json", timeout=30)]
    return _split_cache[1]


def status():
    st = json.loads(read(GUARD_STATE, "{}") or "{}")
    c, cfg = conf(), xray_cfg()
    rules = cfg.get("routing", {}).get("rules", [])
    tags = {r.get("ruleTag") for r in rules}
    rc, _ = run("systemctl", "is-active", "tunnel-guard.timer", timeout=10)
    order = [c.get("primary")] + (c.get("backups") or [c.get("backup")])
    avail = availability()
    return {
        "paths": [dict(name=n, role="primary" if i == 0 else "backup %d" % i,
                       iface=(c.get("paths", {}).get(n) or {}).get("iface"), up24=avail.get(n),
                       **(st.get("last", {}).get(n) or {})) for i, n in enumerate(order) if n],
        "on": st.get("on"), "primary": c.get("primary"), "hold": read(GUARD_HOLD, "").strip(),
        "last_ts": st.get("last_ts"), "guard_active": rc == 0,
        "outages": outages(st, c),
        "features": {
            "split": "split-light" in tags,
            "split_check": split_check(),
            "dns_cache": any(o.get("protocol") == "dns" for o in cfg.get("outbounds", [])),
            "ad_block": any(r.get("domain") == ["geosite:category-ads-all"] for r in rules),
            "tg_backup": setting("tgBotBackup") == "true",

        },
        "cert": {"file": c.get("cert"), "days": cert_days(c["cert"]) if c.get("cert") else None},
        "inbounds": {i["tag"]: (i["remark"] or i["tag"]) for i in inbound_rows()},
        "res": resources(), "month": vnstat_month(), "backups": backups(),
        "xray": run(XRAY, "version", timeout=5)[1].split("\n")[0] if os.path.exists(XRAY) else "",
        "now": int(time.time()),
    }


def units():
    """The units this hub is made of - name, what it is for, and whether it is up."""
    got = [("x-ui", "پنل و Xray"), ("nginx", "جلوی پنل و صفحه‌ی Optimizer"), ("xo-dash", "همین صفحه"),
           ("tunnel-guard.timer", "بررسی مسیرها هر دقیقه"), ("config-guard.path", "نگهبان پیکربندی"),
           ("config-guard.timer", "تور ایمنی نگهبان پیکربندی"),
           ("xui-tunnel.timer", "جابجایی خودکار بین تانل‌ها")]
    for name, p in (conf().get("paths") or {}).items():
        if p.get("iface"):
            got.append(("awg-quick@%s.service" % p["iface"], "تانل " + name))
    out = []
    for unit, what in got:
        rc, raw = run("systemctl", "show", unit, "-p", "ActiveState", "-p", "SubState", "-p", "LoadState",
                      "-p", "ActiveEnterTimestampMonotonic", "-p", "MemoryCurrent", timeout=8)
        d = dict(l.split("=", 1) for l in raw.splitlines() if "=" in l)
        if d.get("LoadState") not in ("loaded",):
            continue
        since = int(d.get("ActiveEnterTimestampMonotonic") or 0) / 1e6
        up = int(float((read("/proc/uptime", "0").split() or ["0"])[0]))
        raw_mem = (d.get("MemoryCurrent") or "0").strip()
        mem = int(raw_mem) if raw_mem.isdigit() else 0          # "[not set]" for units with no cgroup
        out.append({"unit": unit, "what": what, "state": d.get("ActiveState", "?"), "sub": d.get("SubState", ""),
                    "since": int(time.time() - (up - since)) if since else 0,
                    "mem": mem if 0 < mem < (1 << 60) else 0})
    return out


