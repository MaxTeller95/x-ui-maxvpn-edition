        total = sum(got.values())
        m["share"] = {a: round(100.0 * got.get(i, 0) / total) if total else None
                      for i, a in enumerate(m.get("addrs") or [], 1)}
        m["share_bytes"] = total
    return rows


def confguard():
    """What config-guard thinks of the current config (it changes nothing without --fix)."""
    g = jrun("config-guard", "--json", timeout=25)
    if not g:
        return {"error": "config-guard not installed or no baseline yet"}
    # Old events name outbounds and probe ports that were removed on purpose since; they are
    # history, not something to fix. Keep only what the current baseline still watches.
    now = set(g.get("tags") or []) | set(path_order()) | {"guard-" + n.lower() for n in path_order()}
    now |= {o.get("tag") for o in xray_cfg().get("outbounds", [])}
    kept = []
    for e in g.get("events") or []:
        m = e.get("missing") or {}
        m = {k: ([x for x in m.get(k) or [] if x in now] if k != "dns" else m.get(k)) for k in m}
        if any(m.get(k) for k in ("rules", "outbounds", "inbounds", "dns")):
            kept.append(dict(e, missing=m))
    g["events"] = kept
    return g


def availability(hours=24):
    """Share of the guard's checks in which each path answered, from the collector's buckets."""
    with METRICS.lock:
        mins = [m for m in METRICS.minutes if m["t"] > time.time() - hours * 3600]
    tot, ok = collections.Counter(), collections.Counter()
    for m in mins:
        for name, v in (m.get("p") or {}).items():
            tot[name] += 1
            ok[name] += v[1]
    return {n: round(100.0 * ok[n] / tot[n], 2) for n in tot if tot[n]}


