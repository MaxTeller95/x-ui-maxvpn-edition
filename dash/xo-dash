class Jobs:
    """One slot per long tool (mux-bench takes three minutes), so the page can poll."""

    ALLOWED = {"mux-bench": (("mux-bench",), 420)}

    def __init__(self):
        self.lock, self.jobs = threading.Lock(), {}

    def start(self, name, arg=""):
        cmd, limit = self.ALLOWED[name]
        with self.lock:
            j = self.jobs.get(name)
            if j and not j["done"]:
                return {"ok": True, "running": True}
            self.jobs[name] = {"started": int(time.time()), "done": False, "out": "", "rc": None, "arg": arg}
        def work():
            rc, out = run(*cmd, *( [arg] if arg else [] ), timeout=limit)
            with self.lock:
                self.jobs[name].update(done=True, rc=rc, out=out, ended=int(time.time()))
        threading.Thread(target=work, daemon=True).start()
        return {"ok": True, "running": True}

    def get(self, name):
        with self.lock:
            return dict(self.jobs.get(name) or {})


