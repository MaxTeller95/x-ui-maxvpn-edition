def users_view(rows_only=False):
    rates, online = METRICS.user_rates()
    now_ms = int(time.time() * 1000)
    rows, per_inbound = [], collections.Counter()
    with db() as c:
        links = collections.defaultdict(list)
        for r in c.execute("select ci.client_id, i.tag from client_inbounds ci join inbounds i on i.id = ci.inbound_id"):
            links[r[0]].append(r[1])
        traffic = {r["email"]: r for r in c.execute("select email, up, down, last_online from client_traffics")}
        for r in c.execute("select id, email, total_gb, expiry_time, enable, limit_ip, comment from clients"):
            t = traffic.get(r["email"])
            used = (t["up"] + t["down"]) if t else 0
            quota, exp = r["total_gb"] or 0, r["expiry_time"] or 0
            rows.append({
                "email": r["email"], "used": used, "quota": quota,
                "pct": round(100.0 * used / quota, 1) if quota else None,
                # a negative expiry is a plan that starts counting on the first connection
                "days": round((exp - now_ms) / 86400000.0, 1) if exp > 0 else None,
                "pending": round(-exp / 86400000.0) if exp < 0 else None,
                "enable": bool(r["enable"]), "limit_ip": r["limit_ip"] or 0,
                "on": r["email"] in online, "bps": rates.get(r["email"], 0),
                "last": int((t["last_online"] or 0) / 1000) if t else 0,
                "inbounds": links.get(r["id"], []), "comment": r["comment"] or "",
            })
            if r["email"] in online:
                for tag in links.get(r["id"], []):
                    per_inbound[tag] += 1
    if rows_only:
        return rows
    return {
        "total": len(rows), "online": len(online), "enabled": sum(1 for r in rows if r["enable"]),
        "live": sorted([r for r in rows if r["bps"] > 0], key=lambda r: -r["bps"])[:12],
        "expiring": sorted([r for r in rows if r["days"] is not None and r["days"] <= 7 and r["enable"]],
                           key=lambda r: r["days"])[:15],
        "full": sorted([r for r in rows if r["pct"] is not None and r["pct"] >= 85 and r["enable"]],
                       key=lambda r: -r["pct"])[:15],
        "idle": sorted([r for r in rows if is_idle(r)], key=lambda r: r["last"])[:15],
        "idle_total": sum(1 for r in rows if is_idle(r)), "idle_days": IDLE_DAYS,
        "per_inbound": dict(per_inbound), "sharing": sharing(online),
    }


def sharing(online, budget=6.0):
    """How many addresses each online user is connected from, straight from Xray."""
    out, end = [], time.time() + budget

    def one(email):
        if time.time() > end:
            return None
        d = xapi("statsonlineiplist", "-email=" + email, timeout=4)
        return (email, len((d or {}).get("ips") or {})) if d else None

    with ThreadPoolExecutor(max_workers=8) as pool:
        for r in pool.map(one, list(online)[:150]):
            if r and r[1] > 1:
                out.append({"email": r[0], "ips": r[1]})
    return sorted(out, key=lambda r: -r["ips"])[:15]


