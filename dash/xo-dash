def restartable():
    return RESTARTABLE | {u["unit"] for u in units() if u["unit"].startswith("awg-quick@")}


def url_through_paths(url):
    """Does this address open through each path? The question after every new block."""
    out = []
    for name, port in path_ports().items():
        rc, raw = run("curl", "-s", "-o", "/dev/null", "-m", "12", "--socks5-hostname", "127.0.0.1:%d" % port,
                      "-A", "Mozilla/5.0", "-w", "%{http_code} %{time_total} %{size_download}", url, timeout=16)
        p = raw.split()
        out.append({"path": name, "code": p[0] if p else "000", "secs": float(p[1]) if len(p) > 1 else None,
                    "size": int(p[2]) if len(p) > 2 else 0})
    return out


class Jobs:
    """One slot per long tool (mux-bench takes three minutes), so the page can poll."""

    ALLOWED = {"mux-bench": (("mux-bench",), 420)}

    def __init__(self):
        self.lock, self.jobs = threading.Lock(), {}

    def start(self, name, arg=""):
        cmd, limit = self.ALLOWED[name]
        with self.lock:
            j = self.jobs.get(name)
            if j and not j["done"]:
                return {"ok": True, "running": True}
            self.jobs[name] = {"started": int(time.time()), "done": False, "out": "", "rc": None, "arg": arg}
        def work():
            rc, out = run(*cmd, *( [arg] if arg else [] ), timeout=limit)
            with self.lock:
                self.jobs[name].update(done=True, rc=rc, out=out, ended=int(time.time()))
        threading.Thread(target=work, daemon=True).start()
        return {"ok": True, "running": True}

    def get(self, name):
        with self.lock:
            return dict(self.jobs.get(name) or {})


