#!/usr/bin/env python3
"""xo-dash - the Optimizer page shown inside the x-ui panel.

Listens on 127.0.0.1 only. nginx serves it under <panel base path>xo-dash/ and adds an
"Optimizer" item to the panel's sidebar (see install-dash.sh). Every request is checked
against the panel's own login: the browser's panel cookie is replayed to the panel, and
only a logged-in session gets through.

Besides the switches, a background collector reads Xray's stats API every 5 s and keeps
one bucket per minute for 24 h in /var/lib/xo-dash/history.json, so the page can show
live throughput per path, per inbound and per user without touching the panel's database.
"""
import collections, http.server, json, os, re, shutil, sqlite3, ssl, subprocess, threading, time, urllib.parse, urllib.request
from concurrent.futures import ThreadPoolExecutor

DB, CFG = "/etc/x-ui/x-ui.db", "/usr/local/x-ui/bin/config.json"
GUARD_STATE, GUARD_HOLD = "/var/lib/tunnel-guard/state.json", "/var/lib/tunnel-guard/hold"
GUARD_CONF = "/etc/tunnel-guard.json"
XRAY = "/usr/local/x-ui/bin/xray-linux-amd64"
STATE_DIR = "/var/lib/xo-dash"
HIST = os.path.join(STATE_DIR, "history.json")
BACKUP_DIR = "/root"
HERE = os.path.dirname(os.path.realpath(__file__))
LISTEN = ("127.0.0.1", int(os.environ.get("XO_DASH_PORT", "9811")))


def setting(key):
    r = sqlite3.connect(DB).execute("select value from settings where key=?", (key,)).fetchone()
    return r[0] if r else ""


BASE = setting("webBasePath") or "/"
PREFIX = BASE + "xo-dash/"
PANEL = "https://127.0.0.1:%s%spanel/" % (setting("webPort") or 2053, BASE)
_insecure = ssl.create_default_context()
_insecure.check_hostname, _insecure.verify_mode = False, ssl.CERT_NONE
_auth_cache, _lock = {}, threading.Lock()


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):
        return None


_opener = urllib.request.build_opener(NoRedirect, urllib.request.HTTPSHandler(context=_insecure))


def logged_in(cookie):
    """True if this cookie is a live panel session (asks the panel, caches 60 s)."""
    if not cookie:
        return False
    now = time.time()
    with _lock:
        hit = _auth_cache.get(cookie)
        if hit and now - hit[1] < 60:
            return hit[0]
    try:
        ok = _opener.open(urllib.request.Request(PANEL, headers={"Cookie": cookie}), timeout=5).status == 200
    except Exception:
        ok = False
    with _lock:
        _auth_cache[cookie] = (ok, now)
    return ok


def run(*cmd, timeout=60):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 124, str(e)


def jrun(*cmd, timeout=10):
    """Run a command that prints JSON and return the parsed object, or None."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None
    except Exception:
        return None


def jrun_any(*cmd, timeout=10):
    """Like jrun, but a tool that refused (exit 1) still gets to explain itself in JSON."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return json.loads(r.stdout)
    except Exception:
        return None


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default


def db():
    c = sqlite3.connect(DB)
    c.row_factory = sqlite3.Row
    return c


def conf():
    return json.loads(read(GUARD_CONF, "{}") or "{}")


_cfg_cache = [0, None]


def xray_cfg():
    """The live Xray config, re-read when it changes on disk."""
    empty = {"inbounds": [], "outbounds": [], "routing": {"rules": []}}
    try:
        m = os.path.getmtime(CFG)
    except OSError:
        return empty
    if _cfg_cache[0] != m:
        try:
            _cfg_cache[:] = [m, json.load(open(CFG))]
        except Exception:
            return _cfg_cache[1] or empty
    return _cfg_cache[1]


def access_log():
    """Where Xray writes its access log: 2.x used the panel dir, 3.x uses /var/log/x-ui/."""
    got = (xray_cfg().get("log") or {}).get("access") or ""
    if got and got != "none":
        return got if os.path.isabs(got) else os.path.join(os.path.dirname(CFG), got)
    for p in ("/var/log/x-ui/access.log", "/usr/local/x-ui/access.log"):
        if os.path.exists(p):
            return p
    return "/var/log/x-ui/access.log"


def api_addr():
    c = xray_cfg()
    tag = (c.get("api") or {}).get("tag", "api")
    for i in c.get("inbounds", []):
        if i.get("tag") == tag:
            return "%s:%s" % (i.get("listen", "127.0.0.1"), i.get("port"))
    return "127.0.0.1:62789"


def xapi(*args, timeout=10):
    return jrun(XRAY, "api", *args, "--server=" + api_addr(), timeout=timeout)


def path_order():
    """The paths as the Tools tab lists them: primary first, then the backups in order."""
    c = conf()
    return [n for n in [c.get("primary")] + (c.get("backups") or [c.get("backup")]) if n]


def path_ports():
    """{path: probe port} for the listed paths only - what the Health tab watches."""
    ports = probe_ports()
    return {n: ports[n] for n in path_order() if n in ports}


def probe_ports():
    """{outbound tag: local socks port} for the probe inbounds xui-split created."""
    out, cfg = {}, xray_cfg()
    tags = {o.get("tag", "").lower(): o.get("tag") for o in cfg.get("outbounds", [])}
    for i in cfg.get("inbounds", []):
        t = i.get("tag", "")
        if t.startswith("guard-") and t[6:] in tags:
            out[tags[t[6:]]] = i["port"]
    return out


def cert_days(path):
    rc, out = run("openssl", "x509", "-in", path, "-noout", "-enddate")
    if rc:
        return None
    end = out.split("=")[-1]
    return int((time.mktime(time.strptime(end, "%b %d %H:%M:%S %Y %Z")) - time.time()) // 86400)


# ---------------------------------------------------------------- metrics collector

class Metrics(threading.Thread):
    """Samples Xray's counters every STEP seconds and keeps per-minute buckets for a day.

    The counters only go up (the panel reads them without resetting), so a value that
    dropped means Xray restarted and the new value is itself the delta.
    """
    STEP, FINE, DAY = 5, 120, 1440

    def __init__(self):
        super().__init__(daemon=True)
        self.lock = threading.Lock()
        self.fine = collections.deque(maxlen=self.FINE)   # {"t", "o"/"i": {tag: [up, down]}, "u": {email: bytes}}
        self.minutes = collections.deque(self._load(), maxlen=self.DAY)
        self.prev, self.cur, self.online, self.saved, self.n = {}, None, [], 0.0, 0

    def _load(self):
        try:
            cut = time.time() - 86400
            return [m for m in json.loads(read(HIST, "{}") or "{}").get("minutes", []) if m.get("t", 0) > cut]
        except Exception:
            return []

    def _save(self):
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(HIST + ".tmp", "w") as f:
                json.dump({"minutes": list(self.minutes)}, f, separators=(",", ":"))
            os.replace(HIST + ".tmp", HIST)
        except OSError:
            pass

    def sample(self):
        stats = xapi("statsquery", timeout=8) or {}
        now = time.time()
        o, i, u = {}, {}, {}
        for s in stats.get("stat", []):
            parts = (s.get("name", "").split(">>>") + ["", "", "", ""])[:4]
            kind, name, dirn = parts[0], parts[1], parts[3]
            v, p = s.get("value", 0) or 0, self.prev.get(s["name"])
            self.prev[s["name"]] = v
            if p is None:
                continue
            d = v if v < p else v - p
            if not d:
                continue
            slot = 0 if dirn == "uplink" else 1
            if kind == "outbound":
                o.setdefault(name, [0, 0])[slot] += d
            elif kind == "inbound" and not name.startswith("guard-") and name != "api":
                i.setdefault(name, [0, 0])[slot] += d
            elif kind == "user":
                u[name] = u.get(name, 0) + d
        online = self.online
        self.n += 1
        if self.n % 3 == 1:  # who is online changes slowly; every third sample is enough
            on = xapi("statsgetallonlineusers", timeout=8) or {}
            online = [n.split(">>>")[1] for n in (on.get("users") or []) if ">>>" in n]
        with self.lock:
            self.online = online
            self.fine.append({"t": now, "o": o, "i": i, "u": u})
            self._roll(now, o, i, len(online))

    def _roll(self, now, o, i, online):
        m = int(now // 60) * 60
        if self.cur is None or self.cur["t"] != m:
            if self.cur:
                self.minutes.append(self.cur)
            self.cur = {"t": m, "o": {}, "i": {}, "on": 0, "p": {}}
            for name, v in (json.loads(read(GUARD_STATE, "{}") or "{}").get("last") or {}).items():
                self.cur["p"][name] = [round(v.get("rtt") or 0, 1), 1 if v.get("ok") else 0]
            if now - self.saved > 300:
                self.saved = now
                self._save()
        for src, key in ((o, "o"), (i, "i")):
            for tag, (up, dn) in src.items():
                c = self.cur[key].setdefault(tag, [0, 0])
                c[0] += up
                c[1] += dn
        self.cur["on"] = max(self.cur["on"], online)

    def run(self):
        while True:
            try:
                self.sample()
            except Exception:
                pass
            time.sleep(self.STEP)

    def snapshot(self, window=30):
        """Rates over the last `window` seconds, the day's buckets and the top talkers."""
        with self.lock:
            fine = [f for f in self.fine if f["t"] > time.time() - window]
            mins = list(self.minutes) + ([self.cur] if self.cur else [])
            online = list(self.online)
        span = max(float(self.STEP), fine[-1]["t"] - fine[0]["t"]) if len(fine) > 1 else float(self.STEP)
        by_out, by_in, users, up, dn = {}, {}, {}, 0, 0
        for f in (fine[1:] if len(fine) > 1 else fine):
            for src, into in ((f["o"], by_out), (f["i"], by_in)):
                for tag, (a, b) in src.items():
                    c = into.setdefault(tag, [0, 0])
                    c[0] += a
                    c[1] += b
            for e, b in f["u"].items():
                users[e] = users.get(e, 0) + b
        for a, b in by_in.values():
            up, dn = up + a, dn + b
        bps = lambda v: int(v * 8 / span)
        share = {}
        for m in [x for x in mins if x["t"] > time.time() - 3600]:
            for tag, (a, b) in m["o"].items():
                share[tag] = share.get(tag, 0) + a + b
        rtt, listed = collections.defaultdict(list), set(path_order())
        for m in mins[-180:]:
            for name, v in (m.get("p") or {}).items():
                if name in listed:
                    rtt[name].append([m["t"], v[0], v[1]])
        return {
            "t": int(time.time()),
            "rate": {"up": bps(up), "down": bps(dn)},
            "by_out": {k: bps(v[0] + v[1]) for k, v in by_out.items()},
            "by_in": {k: bps(v[0] + v[1]) for k, v in by_in.items()},
            "online": len(online),
            "series": [[m["t"], sum(v[1] for v in m["i"].values()), sum(v[0] for v in m["i"].values()), m["on"]]
                       for m in mins[-180:]],
            "hours": self._hours(mins),
            "share_hour": share,
            "rtt": {k: v[::3] for k, v in rtt.items()},
            "top": sorted(({"email": e, "bps": bps(b)} for e, b in users.items()), key=lambda x: -x["bps"])[:10],
        }

    def _hours(self, mins):
        h = {}
        for m in mins:
            c = h.setdefault(int(m["t"] // 3600) * 3600, [0, 0])
            for v in m["i"].values():
                c[0] += v[0]
                c[1] += v[1]
        return [[k, v[1], v[0]] for k, v in sorted(h.items())]

    def user_rates(self):
        with self.lock:
            fine = [f for f in self.fine if f["t"] > time.time() - 60]
            online = set(self.online)
        u = {}
        for f in fine[1:]:
            for e, b in f["u"].items():
                u[e] = u.get(e, 0) + b
        span = max(float(self.STEP), fine[-1]["t"] - fine[0]["t"]) if len(fine) > 1 else float(self.STEP)
        return {e: int(b * 8 / span) for e, b in u.items()}, online


