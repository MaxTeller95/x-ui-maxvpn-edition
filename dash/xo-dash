def probe_https(port, url="https://www.google.com/generate_204", timeout=10):
    rc, out = run("curl", "-s", "-o", "/dev/null", "-m", str(timeout), "--socks5-hostname", "127.0.0.1:%d" % port,
                  "-w", "%{http_code} %{time_total} %{time_connect}", url, timeout=timeout + 3)
    parts = out.split()
    return None if rc or len(parts) < 3 else {"code": parts[0], "total": float(parts[1]), "connect": float(parts[2])}


def checkup():
    """One button, the whole hub: what a person would check by hand after an outage."""
    c, cfg, res = conf(), xray_cfg(), []
    ports = path_ports()

    def add(level, title, detail, hint=""):
        res.append({"level": level, "title": title, "detail": detail, "hint": hint})

    def clock():
        synced = run("timedatectl", "show", "-p", "NTPSynchronized", "--value", timeout=5)[1].strip()
        off = ""
        rc, out = run("chronyc", "tracking", timeout=5)
        if not rc:
            for line in out.splitlines():
                if line.startswith("System time"):
                    off = " (" + line.split(":", 1)[1].strip() + ")"
        add("ok" if synced == "yes" else "bad", "ساعت سیستم",
            ("هماهنگ با NTP" + off) if synced == "yes" else "هماهنگ نیست",
            "TLS و Reality به ساعت دقیق نیاز دارند؛ اختلاف چند ثانیه‌ای یعنی هندشیک رد می‌شود.")

    def xray_test():
        rc, out = run(XRAY, "run", "-test", "-c", CFG, timeout=30)
        add("ok" if rc == 0 else "bad", "پیکربندی Xray", "سالم است" if rc == 0 else out.splitlines()[-1][:200],
            "" if rc == 0 else "تا وقتی این خطا هست، هر ری‌استارت x-ui کاربران را قطع می‌کند.")

    def paths():
        for name in path_order():
            port = ports.get(name)
            if not port:
                add("bad", "مسیر " + name, "پورت probe ندارد", "در ابزارها، مسیر را حذف و دوباره اضافه کنید.")
                continue
            r = probe_https(port)
            if not r:
                add("bad", "مسیر " + name, "پاسخ نداد", "اگر ادامه پیدا کند، نگهبان کاربران را جابجا می‌کند.")
            else:
                add("ok" if r["total"] < 1.5 else "warn", "مسیر " + name,
                    "HTTP %s در %.2f ثانیه (اتصال %.2f)" % (r["code"], r["total"], r["connect"]))

    def speed():
        name = c.get("primary")
        port = ports.get(name)
        if not port:
            return
        rc, out = run("curl", "-s", "-o", "/dev/null", "-m", "15", "--socks5-hostname", "127.0.0.1:%d" % port,
                      "-w", "%{speed_download}", "https://speed.cloudflare.com/__down?bytes=25000000", timeout=20)
        try:
            mbit = float(out) * 8 / 1e6
        except ValueError:
            return add("warn", "سرعت مسیر اصلی", "اندازه‌گیری نشد")
        add("ok" if mbit > 100 else "warn" if mbit > 25 else "bad", "سرعت مسیر اصلی (%s)" % name,
            "%.0f مگابیت بر ثانیه در دانلود ۲۵ مگابایتی" % mbit,
            "این عدد از خود هاب گرفته شده و سقف چیزی است که کاربر می‌گیرد.")

    def dns():
        if not any(o.get("protocol") == "dns" for o in cfg.get("outbounds", [])):
            return add("warn", "کش DNS", "روشن نیست", "با دستور xui-optimizer روشن می‌شود.")
        port, extra = ports.get(c.get("primary")), ""
        if port:
            r = probe_https(port, "https://1.1.1.1/dns-query?name=example.com&type=A")
            if r:
                extra = " · پاسخ DoH بالادست %.0f میلی‌ثانیه" % (r["total"] * 1000)
        add("ok", "کش DNS", "روشن است؛ جواب‌های تکراری از روی هاب می‌آیند" + extra)

    def mtu():
        p = (c.get("paths") or {}).get(c.get("primary")) or {}
        if not p.get("peer") or not p.get("iface"):
            return
        lo, hi = 1200, 1500
        while lo < hi:
            mid = (lo + hi + 1) // 2
            rc, _ = run("ping", "-c", "1", "-W", "2", "-M", "do", "-s", str(mid - 28), p["peer"], timeout=6)
            lo, hi = (mid, hi) if rc == 0 else (lo, mid - 1)
        cur = int(read("/sys/class/net/%s/mtu" % p["iface"], "0").strip() or 0)
        if lo <= 1200:
            return add("warn", "MTU تانل", "اندازه‌گیری نشد")
        add("ok" if cur <= lo else "warn", "MTU تانل %s" % p["iface"],
            "بزرگ‌ترین بسته‌ی بدون تکه‌شدن %d بایت، تنظیم فعلی %d" % (lo, cur),
            "" if cur <= lo else "MTU بزرگ‌تر از این یعنی بسته‌ها تکه می‌شوند و سرعت می‌افتد.")

    def machine():
        r = resources()
        mem = 100 - (100.0 * r["mem_avail"] / max(1, r["mem_total"]))
        disk = 100 - (100.0 * r["disk_free"] / max(1, r["disk_total"]))
        ld = r["load"][0] / max(1, r["cpus"])
        ct = 100.0 * r["conntrack"] / max(1, r["conntrack_max"])
        worst = max(mem, disk, ct)
        add("bad" if worst > 92 or ld > 2 else "warn" if worst > 80 or ld > 1 else "ok", "منابع سرور",
            "رم %.0f%% · دیسک %.0f%% · بار %.2f روی %d هسته · %d اتصال · conntrack %.0f%%"
            % (mem, disk, r["load"][0], r["cpus"], r["conns"], ct))

    def cert():
        if not c.get("cert"):
            return
        d = cert_days(c["cert"])
        if d is None:
            return add("warn", "گواهی TLS", "خوانده نشد")
        add("ok" if d > 20 else "warn" if d > 7 else "bad", "گواهی TLS", "%d روز اعتبار دارد" % d)

    def subscription():
        """3x-ui 3.3+: a browser opening a subscription link gets a page (usage ring, quota,
        one-tap import, right-to-left for Persian); apps get their configs. Both, for real."""
        if setting("subEnable") != "true":
            return add("warn", "لینک اشتراک", "سرویس اشتراک پنل خاموش است",
                       "در تنظیمات پنل ← اشتراک روشنش کنید تا کاربران لینک اشتراک بگیرند.")
        port, path = setting("subPort") or "2096", setting("subPath") or "/sub/"
        with db() as cn:
            row = cn.execute("select sub_id from clients where enable = true and sub_id != '' limit 1").fetchone()
        if not row:
            return add("warn", "لینک اشتراک", "کلاینت فعالی با لینک اشتراک نیست")
        url = "https://127.0.0.1:%s%s%s" % (port, path, row[0])
        page = run("curl", "-sk", "-m", "8", "-H", "Accept: text/html", "-A", "Mozilla/5.0 (Android 14) Mobile",
                   "-o", "/dev/null", "-w", "%{http_code} %{content_type}", url, timeout=12)[1]
        app = run("curl", "-sk", "-m", "8", "-A", "v2rayNG/1.9", "-o", "/dev/null", "-w", "%{http_code} %{size_download}",
                  url, timeout=12)[1]
        page_ok = page.startswith("200") and "text/html" in page
        app_ok = app.startswith("200") and int((app.split() + ["0", "0"])[1] or 0) > 20
        d = cert_days(setting("subCertFile")) if setting("subCertFile") else None
        detail = "صفحه‌ی اشتراک برای مرورگر %s · کانفیگ برای اپ %s%s" % (
            "باز می‌شود" if page_ok else "باز نمی‌شود", "می‌رسد" if app_ok else "نمی‌رسد",
            (" · گواهی %d روز" % d) if d is not None else "")
        add("ok" if page_ok and app_ok and (d is None or d > 20) else "bad" if not app_ok else "warn",
            "لینک اشتراک (پورت %s)" % port, detail,
            "" if page_ok else "نسخه‌ی پنل صفحه‌ی اشتراک ندارد یا پاسخ نمی‌دهد؛ پنل 3.3 به بعد لازم است.")

    def geo():
        g = jrun("xui-geo", "status", "--json", timeout=20) or {}
        f = (g.get("files") or {}).get("geosite_IR.dat") or {}
        if f.get("age_days") is None:
            return
        add("ok" if f["age_days"] < 14 else "warn", "فهرست‌های ایران (ir-direct)",
            "%.0f روز پیش به‌روز شده%s" % (f["age_days"], " · بستن بدافزار روشن" if g.get("security") else ""),
            "" if f["age_days"] < 14 else "xui-geo update --restart (یا دکمه‌ی به‌روزرسانی در ابزارها)")

    def reach():
        r = reach_view()
        if not r.get("last"):
            return
        v, bad = r["last"], []
        for p in v["ports"]:
            got = v["res"].get(str(p["port"])) or {}          # JSON keys are strings
            answered = [x for x in got.values() if x is not None]
            if answered and 2 * len([x for x in answered if x != "x"]) < len(answered):
                bad.append(p["port"])
        add("ok" if not bad else "bad", "دسترسی از داخل ایران",
            ("همه‌ی %d پورت از %d نقطه‌ی داخل در دسترس‌اند" % (len(v["ports"]), len(v["nodes"]))) if not bad
            else "از داخل ایران وصل نمی‌شوند: " + "، ".join(map(str, bad)),
            "" if not bad else "فیلتر پورت یا مسیر داخلی؛ جدول کامل در کارت «دسترسی از داخل ایران».")

    def panel():
        r = lint()
        bad = [f for f in r["findings"] if f["level"] == "bad"]
        add("bad" if bad else "warn" if r["findings"] else "ok", "سلامت پنل",
            "%d کلاینت، %d اتصال به اینباند" % (r["counts"]["clients"], r["counts"]["links"])
            + ("" if not r["findings"] else " · %d ایراد" % len(r["findings"])),
            "" if not r["findings"] else "جزئیات در کارت «بازرسی پنل».")

    def backup():
        b = backups()
        if not b:
            return add("warn", "بکاپ", "هیچ بکاپی پیدا نشد", "دکمه‌ی «بکاپ بگیر» در همین صفحه.")
        age, tg = (time.time() - b[0]["at"]) / 86400, setting("tgBotBackup") == "true"
        add("ok" if age < 3 or tg else "warn", "بکاپ",
            "آخرین بکاپ %.1f روز پیش%s" % (age, " · بکاپ روزانه‌ی تلگرام روشن است" if tg else ""))

    def config_guard():
        g = confguard()
        if g.get("error"):
            return add("warn", "نگهبان پیکربندی", g["error"])
        miss = g.get("missing") or {}
        gone = (miss.get("rules") or []) + (miss.get("outbounds") or []) + (miss.get("inbounds") or [])
        add("ok" if g.get("ok") else "bad", "نگهبان پیکربندی",
            "%d قانون نشان‌دار زیر نظر است" % len(g.get("tags") or []) if g.get("ok")
            else "از کانفیگ رفته: " + "، ".join(gone[:6]),
            "" if g.get("ok") else "کارت «نگهبان پیکربندی» در همین تب، دکمه‌ی برگرداندن را دارد.")

    def kernel():
        want = {"net.ipv4.tcp_slow_start_after_idle": "0", "net.ipv4.tcp_notsent_lowat": "16384",
                "net.ipv4.tcp_mtu_probing": "1"}
        off = [k for k, v in want.items() if run("sysctl", "-n", k, timeout=5)[1].strip() != v]
        add("ok" if not off else "warn", "تنظیم‌های کرنل",
            "هر سه اعمال شده" if not off else "اعمال نشده: " + "، ".join(off),
            "" if not off else "فایل sysctl/99-proxy-tcp.conf را در /etc/sysctl.d بگذارید و sysctl -p بزنید.")

    for fn in (clock, xray_test, paths, speed, dns, mtu, machine, cert, subscription, geo, reach, panel,
               config_guard, backup, kernel):
        try:
            fn()
        except Exception as e:
            add("warn", fn.__name__, "بررسی انجام نشد: %s" % e)
    score = sum({"ok": 100, "warn": 60, "bad": 0}[r["level"]] for r in res) // max(1, len(res))
    return {"at": int(time.time()), "score": score, "checks": res}


# ---------------------------------------------------------------- actions

def make_backup():
    dest = os.path.join(BACKUP_DIR, "xui-backup-" + time.strftime("%Y%m%d-%H%M%S"))
    os.makedirs(dest, exist_ok=True)
    xuidb.backup_to(dest)
    for src in (CFG, GUARD_CONF):
        if os.path.exists(src):
            shutil.copy2(src, dest)
    return dest


def backup_db_file(src):
    """The database inside a backup: a SQLite file, or a PostgreSQL dump."""
    if os.path.isfile(src):
        return src
    for n in (os.path.basename(xuidb.detect()["path"]), xuidb.PG_DUMP):
        if os.path.exists(os.path.join(src, n)):
            return os.path.join(src, n)
    return os.path.join(src, "x-ui.db")


def action(name, body):
    if name == "hold":
        path = body.get("path") or ""
        if path:
            open(GUARD_HOLD, "w").write(path)
        elif os.path.exists(GUARD_HOLD):
            os.remove(GUARD_HOLD)
        rc, out = run("systemctl", "start", "tunnel-guard.service", timeout=90)  # act now, not in a minute
        return {"ok": rc == 0, "msg": ("pinned to " + path) if path else "automatic again"}
    if name == "guard":
        verb = "enable" if body.get("on") else "disable"
        rc, out = run("systemctl", verb, "--now", "tunnel-guard.timer")
        return {"ok": rc == 0, "msg": out or verb}
    if name == "telegram-test":
        rc, out = run("tunnel-guard", "--test")
        return {"ok": "sent" in out, "msg": out}
    if name == "report":
        rc, out = run("tunnel-guard", "--report", timeout=90)
        return {"ok": rc == 0, "msg": "report sent" if rc == 0 else out}
    if name == "dns-fast":  # restarts x-ui: the page asks first
        rc, out = run("xui-optimizer", "--dns-fast", "on" if body.get("on") else "off", timeout=150)
        lines = [l for l in out.splitlines() if l.strip()]
        return {"ok": rc == 0, "msg": (lines[-2] if rc == 0 and len(lines) > 1 else lines[-1]) if lines else ""}
    if name == "split-tune":  # measures for about a minute, then switches live if it pays
        grp = str(body.get("group") or "")
        if grp not in {g["out"] for g in (jrun("xui-split", "groups", "--json", timeout=30) or [])}:
            return {"ok": False, "msg": "این خروجی پیدا نشد"}
        rows = jrun("xui-split", "tune", grp, "--apply", "--json", timeout=400) or []
        _split_cache[0] = 0
        r = rows[0] if rows else {}
        return {"ok": bool(rows), "msg": ("%s: %s%s" % (grp, r.get("note", ""), " - اعمال شد" if r.get("changed") else ""))
                if rows else "اندازه‌گیری انجام نشد", "result": r}
    if name == "quic":  # restarts x-ui: the page asks first
        _slow.pop("quic", None)
        rc, out = run("xui-optimizer", "--quic", "block" if body.get("on") else "allow", timeout=150)
        lines = [l for l in out.splitlines() if l.strip()]
        return {"ok": rc == 0, "msg": (lines[-2] if rc == 0 and len(lines) > 1 else lines[-1]) if lines else ""}
    if name == "adblock":  # restarts x-ui: the page asks first
        rc, out = run("xui-optimizer", "--adblock", "on" if body.get("on") else "off", timeout=150)
        lines = [l for l in out.splitlines() if l.strip()]
        return {"ok": rc == 0, "msg": (lines[-2] if rc == 0 and len(lines) > 1 else lines[-1]) if lines else ""}
    if name == "split":  # may restart x-ui: the page asks first
        _split_cache[0] = 0
        if body.get("on"):   # already split: repair only what is wrong (live when it can); else build it
            r = jrun_any("xui-split", "fix", "--json", "--no-tg-backup", timeout=180)
            if r:
                return r
            rc, out = run("xui-split", "apply", "--no-tg-backup", timeout=150)
            return {"ok": rc == 0, "msg": out.splitlines()[-1] if out else ""}
        rc, out = run("xui-split", "remove", "--no-tg-backup", timeout=120)
        return {"ok": rc == 0, "msg": out.splitlines()[-1] if out else ""}
    if name == "log":
        src = body.get("source") or "tunnel-guard"
        cmd = ("tail", "-n", "80", access_log()) if src == "access" else LOGS.get(src)
        if not cmd:
            return {"ok": False, "msg": "unknown log"}
        rc, out = run(*cmd, timeout=20)
        return {"ok": True, "msg": out or "(خالی)"}
    if name == "restart":
        unit = str(body.get("unit") or "")
        if unit not in restartable():
            return {"ok": False, "msg": "این سرویس در فهرست مجاز نیست"}
        rc, out = run("systemctl", "restart", unit, timeout=120)
        return {"ok": rc == 0, "msg": out or ("restarted " + unit)}
    if name == "restore":
        got = str(body.get("name") or "")
        src = os.path.join(BACKUP_DIR, got)
        if not SAFE_NAME.match(got) or not os.path.exists(src):
            return {"ok": False, "msg": "این بکاپ پیدا نشد"}
        chosen = backup_db_file(src)
        if not os.path.exists(chosen):
            return {"ok": False, "msg": "دیتابیسی داخل این بکاپ نیست"}
        if chosen.endswith(xuidb.PG_DUMP) != (xuidb.kind() == "postgres"):
            return {"ok": False, "msg": "این بکاپ مال دیتابیس دیگری است (SQLite و PostgreSQL)"}
        make_backup()                                  # never overwrite without a way back
        xuidb.restore(chosen, start=False)
        run("config-guard", "--save", timeout=30)     # the restored config is the one to keep - saved
        rc, out = run("systemctl", "restart", "x-ui", timeout=120)   # before x-ui rewrites config.json
        return {"ok": rc == 0, "msg": "برگردانده شد: " + got}
    if name == "prune-backups":
        keep = {b["name"] for b in backups()[:10]}
        gone = 0
        for n in os.listdir(BACKUP_DIR):
            p = os.path.join(BACKUP_DIR, n)
            if SAFE_NAME.match(n) and n not in keep and time.time() - os.path.getmtime(p) > 7 * 86400:
                shutil.rmtree(p, ignore_errors=True) if os.path.isdir(p) else os.remove(p)
                gone += 1
        return {"ok": True, "msg": "%d بکاپ قدیمی پاک شد" % gone}
    if name == "probe-url":
        url = str(body.get("url") or "").strip()
        if not url.startswith("http"):
            url = "https://" + url
        host = url.split("//", 1)[-1].split("/")[0].lower()
        if not SAFE_URL.match(url) or host.startswith(PRIVATE):
            return {"ok": False, "msg": "آدرس معتبر نیست"}
        return {"ok": True, "result": {"url": url, "paths": url_through_paths(url)}}
    if name == "path-add":                            # restarts x-ui: the page asks first
        got, link = str(body.get("name") or "").strip(), str(body.get("link") or "").strip()
        peer = str(body.get("peer") or "").strip()
        if not got or not link or len(link) > 2000:
            return {"ok": False, "msg": "نام و لینک لازم است"}
        addrs = [a for a in re.split(r"[\s,،]+", str(body.get("addrs") or "")) if a][:8]
        if any(not re.match(r"^[A-Za-z0-9.:-]{2,64}(@[A-Za-z0-9_.-]{1,15})?$", a) for a in addrs):
            return {"ok": False, "msg": "یکی از آدرس‌های اضافه نامعتبر است"}
        cmd = ["xui-path", "add", got, link, "--json"] + (["--peer", peer] if peer else []) + \
              (["--addrs", ",".join(addrs)] if addrs else [])
        r = jrun_any(*cmd, timeout=300)
        return r or {"ok": False, "msg": "اضافه نشد - لاگ xo-dash را ببینید"}
    if name == "path-remove":
        got = str(body.get("name") or "").strip()
        r = jrun_any("xui-path", "remove", got, "--json", timeout=180)
        return r or {"ok": False, "msg": "حذف نشد"}
    if name == "split-set":                     # one exit's own settings, then build or repair
        _split_cache[0] = 0
        grp = str(body.get("group") or "")
        if grp not in {g["out"] for g in (jrun("xui-split", "groups", "--json", timeout=30) or [])}:
            return {"ok": False, "msg": "این خروجی پیدا نشد"}
        cmd = ["xui-split", "set", grp, "--json"]
        if "on" in body:
            cmd.append("--on" if body.get("on") else "--off")
        for key, flag in (("concurrency", "--concurrency"), ("xudp", "--xudp")):
            if body.get(key) is not None:
                cmd += [flag, str(int(body[key]))]
        if body.get("label") is not None:
            cmd += ["--label", str(body["label"])[:40]]
        if body.get("auto"):                     # smart mux decides again; a number locks it
            cmd.append("--auto")
        r = jrun_any(*cmd, timeout=30)
        if not r or not r.get("ok"):
            return r or {"ok": False, "msg": "ذخیره نشد"}
        if "on" in body:          # rules change: the whole split is built again (restarts x-ui)
            rc, out = run("xui-split", "apply", "--no-tg-backup", timeout=180)
            _split_cache[0] = 0
            return {"ok": rc == 0, "msg": out.splitlines()[-2] if rc == 0 and len(out.splitlines()) > 1 else out[-200:]}
        if body.get("auto"):
            run("systemctl", "start", "--no-block", "xui-split-tune.service", timeout=15)
            return {"ok": True, "msg": "mux %s روی خودکار است؛ اندازه‌گیری شروع شد (حدود یک دقیقه)" % grp}
        return jrun_any("xui-split", "fix", "--json", "--no-tg-backup", timeout=180) or r   # mux settings: live
    if name == "reach-run":                      # a round takes a minute or two: started, then polled
        rc, out = run("systemctl", "start", "--no-block", "xui-reach.service", timeout=15)
        return {"ok": rc == 0, "msg": out, "since": int(time.time())}
    if name == "geo-update":                     # restarts x-ui only when a list changed
        _slow.pop("geo", None)
        return jrun_any("xui-geo", "update", "--restart", "--json", timeout=300) or {"ok": False, "msg": "انجام نشد"}
    if name == "security":                       # restarts x-ui: the page asks first
        _slow.pop("geo", None)
        return jrun_any("xui-geo", "security", "on" if body.get("on") else "off", "--json", timeout=150) \
            or {"ok": False, "msg": "انجام نشد"}
    if name == "split-fix":
        _split_cache[0] = 0
        return jrun_any("xui-split", "fix", "--json", "--no-tg-backup", timeout=180) or {"ok": False, "msg": "انجام نشد"}
    if name == "prune-probes":                        # no restart: the API drops the ports
        r = jrun_any("xui-path", "prune", "--json", timeout=90)
        return r or {"ok": False, "msg": "انجام نشد"}
    if name == "tunnel-discover":
        return {"ok": True, "result": jrun("xui-tunnel", "discover", "--json", timeout=60) or []}
    if name in ("tunnel-mix", "tunnel-pin"):           # several tunnels at once (mix: restarts x-ui; the page asks)
        path = str(body.get("name") or "").strip()
        if path not in path_order():
            return {"ok": False, "msg": "این مسیر در فهرست نیست"}
        ok_addr = lambda a: re.match(r"^[A-Za-z0-9.:-]{2,64}(@[A-Za-z0-9_.-]{1,15})?$", a)
        if name == "tunnel-pin":
            addr = str(body.get("addr") or "").strip()
            if addr and not ok_addr(addr):
                return {"ok": False, "msg": "آدرس نامعتبر"}
            return jrun_any("xui-tunnel", "mix", path, "pin", addr or "none", "--json", timeout=30) or                 {"ok": False, "msg": "انجام نشد"}
        if not body.get("on"):
            return jrun_any("xui-tunnel", "mix", path, "off", "--json", timeout=150) or {"ok": False, "msg": "انجام نشد"}
        addrs = [str(a).strip() for a in (body.get("addrs") or []) if str(a).strip()][:6]
        if len(addrs) < 2 or not all(ok_addr(a) for a in addrs):
            return {"ok": False, "msg": "دست‌کم دو تانل معتبر انتخاب کنید"}
        how = str(body.get("how") or "smart")
        weights = [str(max(1, min(3, int(w)))) for w in (body.get("weights") or [])[:len(addrs)]
                   if str(w).isdigit()]
        cmd = ["xui-tunnel", "mix", path, "on", ",".join(addrs), "--how", how, "--json"]
        if weights:
            cmd[-1:-1] = ["--weights", ",".join(weights)]
        return jrun_any(*cmd, timeout=150) or {"ok": False, "msg": "انجام نشد"}
    if name in ("tunnel-set", "tunnel-use", "tunnel-test", "tunnel-add", "tunnel-scan"):
        path = str(body.get("name") or "").strip()
        if path not in path_order():
            return {"ok": False, "msg": "این مسیر در فهرست نیست"}
        if name == "tunnel-scan":                     # every tunnel at once: about 15 seconds
            cmd = ["xui-tunnel", "scan", path, "--json"] + (["--save"] if body.get("save") else [])
            return jrun_any(*cmd, timeout=150) or {"ok": False, "msg": "اسکن انجام نشد"}
        if name == "tunnel-set":
            addrs = [str(a).strip() for a in (body.get("addrs") or []) if str(a).strip()][:8]
            cmd = ["xui-tunnel", "set", path, ",".join(addrs), "--json"]
            if "auto" in body:
                cmd += ["--auto", "on" if body.get("auto") else "off"]
            return jrun_any(*cmd, timeout=20) or {"ok": False, "msg": "ذخیره نشد"}
        addr = str(body.get("addr") or "").strip()
        if not re.match(r"^[A-Za-z0-9.:-]{2,64}(@[A-Za-z0-9_.-]{1,15})?$", addr):
            return {"ok": False, "msg": "آدرس نامعتبر"}
        verb = {"tunnel-use": "use", "tunnel-add": "add"}.get(name, "test")
        return jrun_any("xui-tunnel", verb, path, addr, "--json", timeout=90) or {"ok": False, "msg": "انجام نشد"}
    if name == "job":
        job = str(body.get("job") or "")
        if job not in JOBS.ALLOWED:
            return {"ok": False, "msg": "unknown job"}
        arg = str(body.get("arg") or "") or conf().get("primary") or ""
        if arg and arg not in probe_ports():
            return {"ok": False, "msg": "این اوت‌باند وجود ندارد"}
        return JOBS.start(job, arg)
    if name == "job-status":
        return {"ok": True, "result": JOBS.get(str(body.get("job") or ""))}
    if name == "checkup":
        return {"ok": True, "result": checkup()}
    if name == "fix-inbounds":
        rc, out = run("xui-fix-inbound-lists", "apply", timeout=120)
        return {"ok": rc == 0, "msg": out.splitlines()[-1] if out else "", "full": out}
    if name == "backup":
        try:
            return {"ok": True, "msg": os.path.basename(make_backup())}
        except OSError as e:
            return {"ok": False, "msg": str(e)}
    if name == "confguard-save":
        rc, out = run("config-guard", "--save", timeout=30)
        return {"ok": rc == 0, "msg": out.splitlines()[-1] if out else ""}
    if name == "confguard-fix":
        rc, out = run("config-guard", "--fix", timeout=180)   # restarts x-ui: the page asks first
        return {"ok": rc == 0, "msg": out.splitlines()[-1] if out else ""}
    if name == "probe-client":
        email = str(body.get("email") or "").strip()
        if not email or len(email) > 120:
            return {"ok": False, "msg": "ایمیل کاربر را بنویسید"}
        r = jrun("xui-probe-client", email, "--json", timeout=180)
        if not r:
            return {"ok": False, "msg": "تست انجام نشد (ابزار نصب است؟)"}
        return {"ok": not r.get("error"), "msg": r.get("error", ""), "result": r}
    return {"ok": False, "msg": "unknown action"}


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "xo-dash"
    GETS = {"api/status": status, "api/live": lambda: METRICS.snapshot(), "api/users": users_view,
            "api/lint": lint, "api/confguard": confguard, "api/units": units, "api/paths": paths_view,
            "api/tunnels": tunnels_view, "api/reach": reach_view, "api/speeds": speed_by_inbound}

    def log_message(self, *a):
        pass

    def send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "SAMEORIGIN")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def route(self):
        return self.path.split("?")[0][len(PREFIX):] if self.path.startswith(PREFIX) else None

    def do_GET(self):
        r = self.route()
        if r == "inject.js":  # public on purpose: it only adds a link; the page itself checks login
            js = open(os.path.join(HERE, "inject.js"), "rb").read().replace(b"__PREFIX__", PREFIX.encode())
            return self.send(200, js, "application/javascript")
        if not logged_in(self.headers.get("Cookie", "")):
            self.send_response(302)
            self.send_header("Location", BASE)
            return self.end_headers()
        if r in ("", "index.html"):
            html = open(os.path.join(HERE, "index.html"), "rb").read()
            return self.send(200, html.replace(b"__PREFIX__", PREFIX.encode()).replace(b"__BASE__", BASE.encode()),
                             "text/html; charset=utf-8")
        if r == "api/backup-file":                     # keep a copy off the server
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            got = (q.get("name") or [""])[0]
            src = os.path.join(BACKUP_DIR, got)
            if not SAFE_NAME.match(got) or not os.path.exists(src):
                return self.send(404, {"error": "not found"})
            path = backup_db_file(src)
            if not os.path.exists(path):
                return self.send(404, {"error": "no database in this backup"})
            with open(path, "rb") as f:
                data = f.read()
            self.send_response(200)
            self.send_header("Content-Type", "application/octet-stream")
            self.send_header("Content-Disposition", 'attachment; filename="%s%s"' % (got, ".pgdump" if path.endswith(".pgdump") else ".db"))
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            return self.wfile.write(data)
        if r in self.GETS:
            try:
                return self.send(200, self.GETS[r]())
            except Exception as e:
                return self.send(500, {"error": str(e)})
        self.send(404, {"error": "not found"})

    def do_POST(self):
        r = self.route() or ""
        if not logged_in(self.headers.get("Cookie", "")):
            return self.send(401, {"error": "login to the panel first"})
        if self.headers.get("X-Requested-With") != "xo-dash":  # no cross-site form posts
            return self.send(403, {"error": "bad request"})
        n = int(self.headers.get("Content-Length") or 0)
        body = json.loads(self.rfile.read(n) or b"{}") if n < 20000 else {}
        if r.startswith("api/"):
            try:
                if r == "api/delete-idle":
                    emails = [str(e) for e in (body.get("emails") or []) if isinstance(e, str)][:500]
                    return self.send(200, delete_idle(self.headers.get("Cookie", ""), emails, bool(body.get("all"))))
                return self.send(200, action(r[4:], body))
            except Exception as e:
                return self.send(200, {"ok": False, "msg": str(e)})
        self.send(404, {"error": "not found"})


if __name__ == "__main__":
    METRICS.start()
    http.server.ThreadingHTTPServer(LISTEN, Handler).serve_forever()
