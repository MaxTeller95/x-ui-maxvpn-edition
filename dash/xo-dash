def mix_share(hours=1):
    """{path: {tunnel index: bytes}} over the last hour, from the per-tunnel copies of mixed
    paths (NAME~2 and NAME~2b are the same tunnel; NAME-mux~2 too)."""
    cut, out = time.time() - hours * 3600, {}
    with METRICS.lock:
        rows = [c for t, c in METRICS.copies if t > cut]
    for c in rows:
        for tag, b in c.items():
            base, idx = xuimix.base_of(tag), str(xuimix.copy_index(tag))
            path = base[:-4] if base.endswith("-mux") else base
            if idx:
                out.setdefault(path, {})[int(idx)] = out.setdefault(path, {}).get(int(idx), 0) + b
    return out


def tunnels_view():
