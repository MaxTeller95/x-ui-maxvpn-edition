def die(msg):
    sys.stderr.write("xui-subpage: %s\n" % msg)
    sys.exit(1)


def conf():
    try:
        with open(CONF) as f:
            return dict(DEFAULTS, **json.load(f))
    except (OSError, ValueError):
        return dict(DEFAULTS)


def save_conf(c):
    with open(CONF, "w") as f:
        json.dump(c, f, indent=2)


def parse_env(text, sep="\n"):
    env = {}
    for line in text.split(sep):
        m = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*?)\s*$", line)
        if m:
            env[m.group(1)] = m.group(2).strip("'\"")
    return env


def running_pid():
    """x-ui's main process: from systemd, else any process whose binary is called x-ui."""
    r = subprocess.run(["systemctl", "show", "-p", "MainPID", "--value", SERVICE], capture_output=True, text=True)
    pid = (r.stdout or "").strip()
    if pid.isdigit() and pid != "0":
        return pid
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            if os.path.basename(os.readlink("/proc/%s/exe" % pid)) == "x-ui":
                return pid
        except OSError:
            pass
    return None


def service_env():
    """What systemd would hand x-ui on its next start: Environment= and EnvironmentFile=."""
    env = {}
    r = subprocess.run(["systemctl", "show", "-p", "EnvironmentFiles", "-p", "Environment", SERVICE],
                       capture_output=True, text=True)
    files = []
    for line in (r.stdout or "").splitlines():
        if line.startswith("EnvironmentFiles="):
            files += [f.split(" ")[0].lstrip("-") for f in line[17:].split("\n") if f]
    for f in files + ["/etc/default/x-ui"]:
        try:
            env.update({k: v for k, v in parse_env(open(f).read()).items() if k in DB_KEYS and k not in env})
        except OSError:
            pass
    for line in (r.stdout or "").splitlines():                # Environment= wins over the files
        if line.startswith("Environment="):
            for item in re.findall(r'(?:"[^"]*"|\S)+', line[12:]):
                env.update({k: v for k, v in parse_env(item.strip('"')).items() if k in DB_KEYS})
    return env


_FOUND = None


def detect():
    """Where this panel keeps its data, and which binary it runs - as the panel sees it."""
    global _FOUND
    if _FOUND:
        return _FOUND
    env, source, pid = {}, "default", running_pid()
    xui = "/usr/local/x-ui/x-ui"
    if pid:
        try:
            raw = open("/proc/%s/environ" % pid, "rb").read().decode("utf-8", "replace")
            env = {k: v for k, v in parse_env(raw, "\0").items() if k in DB_KEYS}
            source = "running x-ui (pid %s)" % pid
            exe = os.readlink("/proc/%s/exe" % pid).replace(" (deleted)", "")
            xui = exe if os.path.isfile(exe) else xui
            if os.stat("/proc/%s/root/" % pid).st_ino != os.stat("/").st_ino:
                die("x-ui runs in a container (Docker?) - install inside the container instead")
        except OSError:
            pid = None
    if not pid:
        env = service_env()
        source = "x-ui service settings" if env else "default"
    env.update({k: os.environ[k] for k in DB_KEYS if os.environ.get(k)})   # ours override
    kind = "postgres" if env.get("XUI_DB_TYPE", "").strip().lower() in ("postgres", "postgresql", "pg") else "sqlite"
    path = os.environ.get("XUI_DB") or "%s/x-ui.db" % (env.get("XUI_DB_FOLDER") or "/etc/x-ui").rstrip("/")
    _FOUND = {"kind": kind, "dsn": env.get("XUI_DB_DSN", "").strip(), "path": path, "source": source,
              "bin": os.environ.get("XUI_BIN") or xui, "running": bool(pid)}
    return _FOUND


def xui_bin():
    return detect()["bin"]


class Sqlite:
    def __init__(self, path):
        if not os.path.isfile(path):
            die("no 3x-ui database at %s (set XUI_DB, or XUI_DB_TYPE/XUI_DB_DSN)" % path)
        self.c = sqlite3.connect(path)

    def rows(self, sql):
        return self.c.execute(sql).fetchall()

    def tables(self):
        return {r[0] for r in self.rows("select name from sqlite_master where type='table'")}

    def columns(self, table):
        return {r[1] for r in self.rows("pragma table_info(%s)" % table)}

    def get(self, key, default):
        r = self.c.execute("select value from settings where key=?", (key,)).fetchone()
        return r[0] if r else default

    def put(self, key, value):
        if self.c.execute("update settings set value=? where key=?", (value, key)).rowcount == 0:
            self.c.execute("insert into settings (key, value) values (?, ?)", (key, value))
        self.c.commit()


class Postgres:
    """3x-ui 3.x can keep its data in PostgreSQL (XUI_DB_TYPE=postgres). Talked to with psql;
    the connection goes through libpq's environment so the password is not on a command line."""
    def __init__(self, dsn):
        if not shutil.which("psql"):
            die("the panel uses PostgreSQL and psql is missing (apt install postgresql-client)")
        u = urllib.parse.urlsplit(dsn)
        q = dict(urllib.parse.parse_qsl(u.query))
        self.env = dict(os.environ, PGHOST=u.hostname or "127.0.0.1", PGPORT=str(u.port or 5432),
                        PGUSER=urllib.parse.unquote(u.username or ""), PGPASSWORD=urllib.parse.unquote(u.password or ""),
                        PGDATABASE=u.path.lstrip("/"), PGSSLMODE=q.get("sslmode", "prefer"), PGCONNECT_TIMEOUT="10")
        self.rows("select 1")

    @staticmethod
    def lit(v):
        return "'" + str(v).replace("'", "''") + "'"

    def rows(self, sql):
        r = subprocess.run(["psql", "-X", "-q", "-At", "-F", "\x1f", "-v", "ON_ERROR_STOP=1", "-c", sql],
                           capture_output=True, text=True, env=self.env, timeout=30)
        if r.returncode:
            die("PostgreSQL: %s" % (r.stderr.strip().splitlines() or ["error"])[-1])
        return [tuple(l.split("\x1f")) for l in r.stdout.splitlines() if l]

    def tables(self):
        return {r[0] for r in self.rows("select table_name from information_schema.tables where table_schema = current_schema()")}

    def columns(self, table):
        return {r[0] for r in self.rows("select column_name from information_schema.columns where table_schema = "
                                         "current_schema() and table_name = %s" % self.lit(table))}

    def get(self, key, default):
        r = self.rows("select value from settings where key = %s limit 1" % self.lit(key))
        return r[0][0] if r else default

    def put(self, key, value):
        k, v = self.lit(key), self.lit(value)
        self.rows("with u as (update settings set value = %s where key = %s returning 1) "
                  "insert into settings (key, value) select %s, %s where not exists (select 1 from u)" % (v, k, k, v))


def db():
    d = detect()
    if d["kind"] == "postgres":
        if not d["dsn"]:
            die("x-ui is set to PostgreSQL but has no XUI_DB_DSN")
        return Postgres(d["dsn"])
    return Sqlite(d["path"])


def describe():
    d = detect()
    where = re.sub(r"//[^@/]*@", "//", d["dsn"]) if d["kind"] == "postgres" else d["path"]   # no password
    return "%s %s (from %s)" % (d["kind"], where, d["source"])


def setting(c, key, default=""):
    return c.get(key, default)


def put(c, key, value):
    c.put(key, value)


def original():
    """The panel's subscription page as built into this x-ui binary (Go embeds files as they are)."""
    xui = xui_bin()
    if not os.path.isfile(xui):
        die("no x-ui binary at %s (set XUI_BIN)" % xui)
    b = open(xui, "rb").read()
    if b"subThemeDir" not in b:
        die("this 3x-ui has no \"Sub Theme Directory\" setting - update the panel first")
    for m in re.finditer(rb"<!doctype html>", b, re.I):
        end = b.find(b"</html>", m.start())
        page = b[m.start():end + 7]
        if end > 0 and len(page) < 50000 and b"/subpage-" in page:
            return page.decode("utf-8")
    die("the subscription page was not found in %s - this needs 3x-ui 3.x" % xui)


def asset(page):
    m = re.search(r"/(subpage-[\w-]+\.js)", page or "")
    return m.group(1) if m else ""


def build(c, cf):
    page = original()
    base = "/" + setting(c, "subPath", "/sub/").strip("/") + "/"
    base = "/" if base == "//" else base
    if base != "/":                                           # what the panel does to its own page
        page = page.replace('src="/assets/', 'src="%sassets/' % base).replace('href="/assets/', 'href="%sassets/' % base)
    if "{{" in page or page.count("<head>") != 1 or page.count("</head>") != 1 or page.count("</body>") != 1:
        die("the panel's page does not look as expected; nothing changed")
    js_base = json.dumps(base)[1:-1].replace("<", "\\u003c")
    page = page.replace("<head>", "<head>\n" + BOOT % ("true" if cf["always"] else "false"), 1)
    page = page.replace("</head>", DATA % (js_base, "true" if cf["jalali"] else "false") + STYLE + "</head>", 1)
    page = page.replace("</body>", STAMP.replace('class="xo-stamp"', 'class="xo-stamp"%s' % ("" if cf["stamp"] else " hidden style=\"display:none!important\"")) + "</body>", 1)
    os.makedirs(DIR, exist_ok=True)
    with open(DIR + "/index.html.new", "w", encoding="utf-8") as f:
        f.write(page)
    os.chmod(DIR + "/index.html.new", 0o644)
    os.replace(DIR + "/index.html.new", DIR + "/index.html")
    return asset(page)


def sub_ids(c):
    """Subscription ids the panel knows, wherever this version keeps them."""
    found = []
    tables = c.tables()
    for table in ("clients", "client_traffics"):
        if table in tables:
            cols = c.columns(table)
            for col in ("sub_id", "subId"):
                if col in cols:
                    found += [r[0] for r in c.rows("select %s from %s where coalesce(%s, '') <> '' limit 5" % (col, table, col))]
    if not found and "inbounds" in tables:                    # clients inside each inbound's settings
        for (s,) in c.rows("select settings from inbounds"):
            try:
                found += [x.get("subId") for x in json.loads(s or "{}").get("clients", []) if x.get("subId")]
            except (ValueError, AttributeError):
                pass
    return found


def probe(c, sid=None):
    """Fetch one real subscription as a browser would, from this server itself."""
    if setting(c, "subEnable", "true") != "true":
        return None, "subscriptions are off in the panel (Settings -> Subscription)"
    if sid:
        sid = sid.rstrip("/").split("?")[0].rsplit("/", 1)[-1]   # a whole link works too
    else:
        ids = sub_ids(c)
        if not ids:
            return None, ("no client has a subscription id yet - add one to a client, or open a "
                          "subscription link in a browser, or pass --sub ID")
        sid = ids[0]
    tls = bool(setting(c, "subCertFile") and setting(c, "subKeyFile"))
    host = setting(c, "subListen") or "127.0.0.1"
    host = "127.0.0.1" if host in ("0.0.0.0", "::") else ("[%s]" % host if ":" in host else host)
    path = ("/" + setting(c, "subPath", "/sub/").strip("/") + "/").replace("//", "/")
    url = "%s://%s:%s%s%s" % ("https" if tls else "http", host, setting(c, "subPort", "2096"), path, sid)
    ctx = ssl.create_default_context()
    ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE        # the certificate names the domain
    try:
        req = urllib.request.Request(url, headers={"Accept": "text/html", "User-Agent": "xui-subpage"})
        with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
            return r.read().decode("utf-8", "replace"), ""
    except urllib.error.HTTPError as e:
        return None, "%s answered HTTP %s%s" % (url, e.code, " (unknown subscription id)" if e.code in (400, 404) else "")
    except Exception as e:
        return None, "%s: %s" % (url, e)


def ours(c):
    cur = setting(c, "subThemeDir")
    return bool(cur) and os.path.realpath(cur) == os.path.realpath(DIR)


def path_unit(enable):
    if os.path.exists("/etc/systemd/system/xui-subpage.path"):
        subprocess.run(["systemctl", "enable" if enable else "disable", "--now", "xui-subpage.path"],
                       capture_output=True)


def status(as_json=False, sid=None):
    c = db()
    body, err = probe(c, sid)
    try:
        current = asset(open(DIR + "/index.html", encoding="utf-8").read())
    except OSError:
        current = ""
    st = {"version": VERSION, "database": describe(), "theme_dir": setting(c, "subThemeDir"), "on": ours(c),
          "serving": "persian" if body and MARK in body else ("panel" if body else "unknown"),
          "current": bool(current) and current == asset(original()), "options": conf(), "error": err}
    if as_json:
        print(json.dumps(st))
        return 0
    print("database  : %s" % st["database"])
    print("theme dir : %s" % (st["theme_dir"] or "(empty - the panel's own page)"))
    print("serving   : %s%s" % (st["serving"], " (%s)" % err if err else ""))
    if st["on"]:
        o = st["options"]
        print("options   : jalali=%s stamp=%s always=%s" % (o["jalali"], o["stamp"], o["always"]))
        if not st["current"]:
            print("outdated  : the panel was updated - run `xui-subpage refresh`")
    return 0


def on(args):
    cf = conf()
    sid = opt(args, "--sub")
    for a in args:
        if a == sid or a == "--sub":
            continue
        if a == "--no-jalali":
            cf["jalali"] = False
        elif a == "--jalali":
            cf["jalali"] = True
        elif a == "--no-stamp":
            cf["stamp"] = False
        elif a == "--stamp":
            cf["stamp"] = True
        elif a == "--always":
            cf["always"] = True
        elif a == "--once":
            cf["always"] = False
        else:
            die("unknown option: %s" % a)
    c = db()
    before = setting(c, "subThemeDir")
    build(c, cf)
    save_conf(cf)
    put(c, "subThemeDir", DIR)
    body, err = probe(c, sid)
    if body is not None and MARK not in body:
        put(c, "subThemeDir", before)
        die("the panel did not serve the template (see `journalctl -u x-ui | grep sub:`) - "
            "setting put back to %r" % before)
    path_unit(True)
    print("Persian subscription page on%s" % (" (not verified: %s)" % err if body is None else ""))
    return 0


def refresh():
    c = db()
    if not ours(c):
        print("off - nothing to refresh")
        return 0
    print("rebuilt for %s" % build(c, conf()))
    return 0


def off():
    c = db()
    if ours(c):
        put(c, "subThemeDir", "")
    path_unit(False)
    print("the panel's own subscription page is back")
    return 0


def show_detect(shell=False):
    d = detect()
    if shell:                                                 # for install.sh
        print("XUI_KIND=%s" % d["kind"])
        print("XUI_BIN_FOUND=%s" % d["bin"])
        return 0
    print("database : %s" % describe())
    print("binary   : %s" % d["bin"])
    print("running  : %s" % ("yes" if d["running"] else "no"))
    return 0


def opt(args, name):
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args):
            die("%s needs a value" % name)
        return args[i + 1]
    return None


def main(a):
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if a[0] in ("-v", "--version", "version"):
        print(VERSION)
        return 0
    if os.geteuid() != 0:
        die("run as root")
    if a[0] == "on":
        return on(a[1:])
    cmds = {"status": lambda: status("--json" in a, opt(a, "--sub")), "refresh": refresh, "off": off,
            "detect": lambda: show_detect("--shell" in a)}
    if a[0] not in cmds:
        die("unknown command: %s (on | status | refresh | off)" % a[0])
    return cmds[a[0]]()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
